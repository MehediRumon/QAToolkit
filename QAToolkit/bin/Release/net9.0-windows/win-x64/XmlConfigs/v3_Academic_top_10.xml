<Page name="UMS">

	<!-- v1 2018-07-09 1738 -->
	<!-- v2 2024-12-23 1718 -->
	<!-- v3 2026-01-07 1718 -->

	<!-- OMR medical a4 10 -->
	<design designFor="omr_10" mappingStyle="grid-y-read-generate" gridX="54" gridY="26"  blackPixelPercent="60">
		<!-- Auto Rotation-->
		<!--TOP-->
		<rotate180Detection direction="x" charSet="1" lines="1" resultCountCellX="0.5" resultCountCellY="1" blackPixelPercent="33">
			<startCircle x="2" y="5" />
			<startPadding x="0" y="0" />
			<borderRemovePercent useBR ="false" top="0" left="0" bottom="0" right="0" />
		</rotate180Detection>

		<!--BOTTOM-->
		<rotate180DetectionAlt direction="x" charSet="1" lines="1" resultCountCellX="0.5" resultCountCellY="1" blackPixelPercent="33">
			<startCircle x="53" y="22" />
			<startPadding x=".5" y=".35" />
			<borderRemovePercent useBR ="false" top="0" left="0" bottom="0" right="0" />
		</rotate180DetectionAlt>

		<!--IMAGE PART-1-->
		<imagePart id="barcode" direction="x" charSet="1" lines="1" resultCountCellX="9" resultCountCellY="6.58">
			<startCircle x="3" y="1" />
			<startPadding x="0" y="0" />
			<borderRemovePercent useBR="false"/>
		</imagePart>

		<!--IMAGE PART-2-->
		<imagePart id="qrCode" direction="y" charSet="1" lines="1" resultCountCellX="7" resultCountCellY="6.65">
			<startCircle x="45" y="1" />
			<startPadding x="0" y="0" />
			<borderRemovePercent useBR="false"/>
		</imagePart>
		<omrInfo isVirtual="true" defaultValue="1" memberName="omrNo"/>

		<omr omrNo="1">

			<!--TOP Marker-->
			<region direction="x" charSet="1" lines="1" resultCountCellX="0.5" resultCountCellY="1" blackPixelPercent="33" memberName="rotationTop">
				<startCircle x="2" y="5" />
				<startPadding x="0" y="0" />
				<borderRemovePercent useBR ="false" top="0" left="0" bottom="0" right="0" />
			</region>

			<!-- BOTTOM Marker-->
			<region direction="x" charSet="1" lines="1" resultCountCellX="0.5" resultCountCellY="1" blackPixelPercent="33"  memberName="rotationBottom">
				<startCircle x="53" y="22" />
				<startPadding x=".5" y=".35" />
				<borderRemovePercent useBR ="false" top="0" left="0" bottom="0" right="0" />
			</region>

			<!--UNIT-->
			<region isVirtual="true" defaultValue="A" memberName="unit" />

			<!--GROUP-->
			<region isVirtual="true" defaultValue="X" memberName="group" />

			<!--SHIFT-->
			<region isVirtual="true" defaultValue="1" memberName="shiftCode" />

			<!--Quota-->
			<region isVirtual="true" defaultValue="X" memberName="quota" />

			<!--SETCODE-->
			<region isVirtual="true" defaultValue="X" memberName="setcode" />

			<!--Program Roll-->
			<region direction="y" charSet="0123456789" lines="11" useSeparator="false" useErrorChar="true" memberName="rollNo">
				<startCircle x="3" y="12" />
				<startPadding x="0" y="0" />
				<spacing x=".5" y=".5" />
				<borderRemovePercent useBR ="true" top="21" left="21" bottom="21" right="21" />
			</region>

			<!--Registration Number-->
			<region direction="y" charSet="0123456789" lines="7" useSeparator="false" useErrorChar="true" memberName="registrationNo">
				<startCircle x="21" y="12" />
				<startPadding x=".03" y="0" />
				<spacing x=".5" y=".5" />
				<borderRemovePercent useBR ="true" top="21" left="21" bottom="21" right="21" />
			</region>

			<!--Answer 1-10 -->
			<region direction="x" charSet="ABCD" lines="10" useSeparator="true" useErrorChar="false" joinOutput="false" lineStart="1" memberName="answer">
				<startCircle x="35" y="12" />
				<startPadding x=".03" y=".03" />
				<spacing x=".5" y=".5" />
				<borderRemovePercent useBR ="true" top="21" left="21" bottom="21" right="21" />
			</region>

			<!--Question Quality-->
			<region direction="y" charSet="S,H,E" charSetSeparators="," lines="1" useSeparator="true" useErrorChar="false" memberName="QuestionQuality">
				<startCircle x="46" y="13" />
				<startPadding x=".56" y="0" />
				<spacing x="1" y="1" />
				<borderRemovePercent useBR ="true" top="21" left="21" bottom="21" right="21" />
			</region>

		</omr>
	</design>
</Page>