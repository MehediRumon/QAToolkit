@model List<string>
@{
    ViewData["Title"] = "OMR Config Manager";
}

<div class="page-header">
    <div>
        <h1>OMR Config Manager</h1>
        <p>Manage XML configuration files for OMR sheet processing.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-upload"></i> Upload Configuration
            </div>
            <div class="card-body">
                <form method="post" asp-action="UploadConfig" enctype="multipart/form-data">
                    <div class="row align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">XML Configuration File</label>
                            <input type="file" name="configFile" class="form-control" accept=".xml" required />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-upload"></i> Upload
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-folder"></i> Available Configurations (@Model.Count)
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 60%">File Name</th>
                                    <th style="width: 20%">Type</th>
                                    <th style="width: 20%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var config in Model)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-file-earmark-code text-primary"></i>
                                            @config
                                        </td>
                                        <td><span class="badge bg-info">XML</span></td>
                                        <td>
                                            <form method="post" asp-action="DeleteConfig" class="d-inline"
                                                  data-confirm="Delete this configuration? This action cannot be undone." data-confirm-title="Delete configuration">
                                                <input type="hidden" name="fileName" value="@config" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-folder2-open" style="font-size: 3rem;"></i>
                        <p class="mt-2 mb-0">No configuration files found. Upload an XML file to get started.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Configuration Info
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>XML configs define:</strong></p>
                <ul class="mb-0 ps-3">
                    <li>OMR region positions</li>
                    <li>Character sets for fields</li>
                    <li>Grid spacing and padding</li>
                    <li>Page detection settings</li>
                    <li>Roll/Registration field mapping</li>
                    <li>Answer region definitions</li>
                </ul>
            </div>
        </div>
    </div>
</div>
