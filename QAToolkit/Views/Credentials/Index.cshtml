@model IEnumerable<QAToolkit.Models.Credential>
@{
    ViewData["Title"] = "Credentials";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-key"></i> Credentials</h2>
    <a asp-action="Create" class="btn btn-warning"><i class="bi bi-plus-lg"></i> Add Credential</a>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Type</label>
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var t in ViewBag.Types as List<string?>)
                    {
                        <option value="@t" selected="@(ViewBag.SelectedType == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Environment</label>
                <select name="environment" class="form-select">
                    <option value="">All Environments</option>
                    @foreach (var env in ViewBag.Environments as List<string?>)
                    {
                        <option value="@env" selected="@(ViewBag.SelectedEnvironment == env)">@env</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary me-2"><i class="bi bi-funnel"></i> Filter</button>
                <a href="/Credentials" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Credentials List -->
@{
    var usernameTypes = Model.Where(c => c.Type == "UMS" || c.Type == "Scheduler" || c.Type == "OM" || c.Type == "API" || c.Type == "App").ToList();
    var studentPortalTypes = Model.Where(c => c.Type == "Student Portal").ToList();
    var teacherPortalTypes = Model.Where(c => c.Type == "Teacher Portal").ToList();
    var otherTypes = Model.Where(c => c.Type != "UMS" && c.Type != "Scheduler" && c.Type != "OM" && c.Type != "API" && c.Type != "App" && c.Type != "Student Portal" && c.Type != "Teacher Portal").ToList();
}

@if (!Model.Any())
{
    <div class="card">
        <div class="text-center py-5 text-muted">
            <i class="bi bi-key fs-1"></i>
            <p class="mt-2">No credentials found. <a asp-action="Create">Add your first credential</a></p>
        </div>
    </div>
}

@if (usernameTypes.Any())
{
    <div class="card mb-4">
        <div class="card-header bg-light border-bottom">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-circle"></i> Username Based Credentials</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 12%;">Type</th>
                        <th class="text-center" style="width: 22%;">Username</th>
                        <th class="text-center" style="width: 18%;">Password</th>
                        <th class="text-center" style="width: 20%;">URL</th>
                        <th class="text-center" style="width: 12%;">Environment</th>
                        <th class="text-center" style="width: 16%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in usernameTypes)
                    {
                        <tr>
                            <td class="text-center">@item.Type</td>
                            <td class="text-center">
                                @item.Username
                                <button class="btn btn-sm btn-link p-0 ms-1" onclick="copyToClipboard('@item.Username', this)" title="Copy">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </td>
                            <td class="text-center">
                                <span class="password-hidden" id="pwd-@item.Id">********</span>
                                <span class="password-visible d-none" id="pwd-show-@item.Id">@item.Password</span>
                                <button class="btn btn-sm btn-link p-0 ms-1" onclick="togglePassword(@item.Id)" title="Show/Hide">
                                    <i class="bi bi-eye" id="eye-@item.Id"></i>
                                </button>
                                <button class="btn btn-sm btn-link p-0 ms-1" onclick="copyToClipboard('@item.Password', this)" title="Copy">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url" target="_blank" class="text-decoration-none" title="@item.Url">
                                        <i class="bi bi-link-45deg"></i> @(item.Url.Length > 30 ? item.Url.Substring(0, 30) + "..." : item.Url)
                                    </a>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.Environment))
                                {
                                    var envClass = item.Environment?.ToLower() switch
                                    {
                                        "dev" => "badge-env-dev",
                                        "live" => "badge-env-prod",
                                        "alpha" => "badge-env-qa",
                                        "rc" => "badge-env-staging",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @envClass">@item.Environment</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this credential?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

