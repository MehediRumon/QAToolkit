@section Scripts {
<script>
function togglePassword(id) {
    var hidden = document.getElementById('pwd-' + id);
    var visible = document.getElementById('pwd-show-' + id);
    var eye = document.getElementById('eye-' + id);
    if (hidden.classList.contains('d-none')) {
        hidden.classList.remove('d-none');
        visible.classList.add('d-none');
        eye.classList.remove('bi-eye-slash');
        eye.classList.add('bi-eye');
    } else {
        hidden.classList.add('d-none');
        visible.classList.remove('d-none');
        eye.classList.remove('bi-eye');
        eye.classList.add('bi-eye-slash');
    }
}
</script>
}
