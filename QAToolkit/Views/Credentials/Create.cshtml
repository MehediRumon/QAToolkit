@model QAToolkit.Models.Credential
@{
    ViewData["Title"] = "Add Credential";
}

<div class="page-header">
    <div><h1>Add Credential</h1></div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Environment" class="form-label">Environment</label>
                            <select asp-for="Environment" class="form-select">
                                <option value="">Select</option>
                                <option>Dev</option>
                                <option>Live</option>
                                <option>Alpha</option>
                                <option>RC</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Type" class="form-label">Type <span class="text-danger">*</span></label>
                            <select asp-for="Type" class="form-select" id="typeSelect" onchange="updateUsernameLabel()">
                                <option value="">Select Type</option>
                                <option>UMS</option>
                                <option>Student Portal</option>
                                <option>Teacher Portal</option>
                                <option>Scheduler</option>
                                <option>OM</option>
                                <option>API</option>
                                <option>App</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3" id="customTypeDiv" style="display: none;">
                            <label for="customType" class="form-label">Custom Type <span class="text-danger">*</span></label>
                            <input type="text" id="customType" class="form-control" placeholder="Enter custom type" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Username" class="form-label" id="usernameLabel">Username <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" id="usernameInput" placeholder="" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Url" class="form-label">URL</label>
                        <input asp-for="Url" class="form-control" placeholder="https://example.com/login" />
                        <div class="form-text">Login page or application URL</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg"></i> Save Credential</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateUsernameLabel() {
            const type = document.getElementById('typeSelect').value;
            const label = document.getElementById('usernameLabel');
            const input = document.getElementById('usernameInput');
            const customTypeDiv = document.getElementById('customTypeDiv');
            const customTypeInput = document.getElementById('customType');
            
            // Show/hide custom type input
            if (type === 'Other') {
                customTypeDiv.style.display = 'block';
                customTypeInput.required = true;
            } else {
                customTypeDiv.style.display = 'none';
                customTypeInput.required = false;
                customTypeInput.value = '';
            }
            
            // Update username label
            if (type === 'Student Portal') {
                label.innerHTML = 'Registration Number <span class="text-danger">*</span>';
                input.placeholder = 'e.g., 2024001';
            } else if (type === 'Teacher Portal') {
                label.innerHTML = 'TPIN <span class="text-danger">*</span>';
                input.placeholder = 'e.g., T12345';
            } else {
                label.innerHTML = 'Username <span class="text-danger">*</span>';
                input.placeholder = 'e.g., admin@example.com';
            }
        }
        
        // Form submission handler to ensure custom type is set
        document.querySelector('form').addEventListener('submit', function(e) {
            const typeSelect = document.getElementById('typeSelect');
            const customTypeInput = document.getElementById('customType');
            
            if (typeSelect.value === 'Other') {
                if (customTypeInput.value.trim()) {
                    // Create a temporary input to submit the custom type value
                    const tempInput = document.createElement('input');
                    tempInput.type = 'hidden';
                    tempInput.name = 'Type';
                    tempInput.value = customTypeInput.value.trim();
                    this.appendChild(tempInput);
                    
                    // Remove the name attribute from the select to avoid conflict
                    typeSelect.removeAttribute('name');
                } else {
                    e.preventDefault();
                    alert('Please enter a custom type.');
                    customTypeInput.focus();
                }
            }
        });
    </script>
}
