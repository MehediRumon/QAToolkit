@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted mt-1">Overview of your testing resources and tools.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <a href="/UrlResources" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--info-100); --icon-color: var(--info-700);">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div class="dash-card-body">
                <h5>URL Manager</h5>
                <p>Save and organize testing URLs for staging, production, APIs, and more.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a href="/TestNotes" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--success-100); --icon-color: var(--success-700);">
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="dash-card-body">
                <h5>Test Notes</h5>
                <p>Quick notes for bug reproduction steps, observations, and screenshots.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a href="/Credentials" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--warning-100); --icon-color: var(--warning-700);">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div class="dash-card-body">
                <h5>Credentials</h5>
                <p>Store test account credentials organized by project and environment.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a href="/ReleaseNotes" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--brand-100); --icon-color: var(--brand-700);">
                <i class="bi bi-rocket-takeoff"></i>
            </div>
            <div class="dash-card-body">
                <h5>Release Notes</h5>
                <p>Track release versions, new features, and testing status.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a href="/MeetingNotes" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--danger-100); --icon-color: var(--danger-700);">
                <i class="bi bi-people"></i>
            </div>
            <div class="dash-card-body">
                <h5>Meeting Notes</h5>
                <p>Save meeting notes, action items, and attendee information.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a href="/Workflows" class="dash-card">
            <div class="dash-card-icon" style="--icon-bg: var(--gray-100); --icon-color: var(--gray-700);">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div class="dash-card-body">
                <h5>Workflows</h5>
                <p>Document and share team workflows with HTML imports and public links.</p>
            </div>
            <i class="bi bi-arrow-right dash-card-arrow"></i>
        </a>
    </div>
</div>
