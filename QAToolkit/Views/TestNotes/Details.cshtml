@model QAToolkit.Models.TestNote
@{
    ViewData["Title"] = "Note Details";
    var statusClass = Model.Status switch
    {
        "Fixed" => "success",
        "Posted" => "brand",
        "Not Posted" => "warning",
        "Not Fixed" => "danger",
        _ => "muted"
    };
}

<div class="page-header">
    <div>
        <h1>@Model.Title</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            @if (!string.IsNullOrEmpty(Model.Status))
            {
                <span class="badge-status @statusClass">@Model.Status</span>
            }
            @if (!string.IsNullOrEmpty(Model.Project))
            {
                <span class="badge bg-info">@Model.Project</span>
            }
            <span class="text-muted small">
                <i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("MMM dd, yyyy")
            </span>
        </div>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="Delete this test note? This action cannot be undone." data-confirm-title="Delete test note">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="detail-meta">
    <div class="detail-meta-item">
        <span class="detail-meta-label">Project</span>
        <span class="detail-meta-value">@(Model.Project ?? "—")</span>
    </div>
    <div class="detail-meta-item">
        <span class="detail-meta-label">Server</span>
        <span class="detail-meta-value">@(Model.Server ?? "—")</span>
    </div>
    <div class="detail-meta-item">
        <span class="detail-meta-label">Status</span>
        <span class="detail-meta-value">
            @if (!string.IsNullOrEmpty(Model.Status))
            {
                <span class="badge-status @statusClass">@Model.Status</span>
            }
            else
            {
                <text>—</text>
            }
        </span>
    </div>
    @if (Model.UpdatedAt.HasValue)
    {
        <div class="detail-meta-item">
            <span class="detail-meta-label">Updated</span>
            <span class="detail-meta-value">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
        </div>
    }
</div>

<div class="detail-section">
    <div class="detail-section-title"><i class="bi bi-card-text"></i> Description</div>
    <div class="detail-content">@Model.Description</div>
</div>

@if (!string.IsNullOrEmpty(Model.Remarks))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-chat-square-text"></i> Remarks</div>
        <div class="detail-content">@Model.Remarks</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ImageVideoUrl))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-paperclip"></i> Media</div>
        <a href="@Model.ImageVideoUrl" target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-arrow-up-right"></i> Open Media Link
        </a>
    </div>
}
