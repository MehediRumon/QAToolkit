@model QAToolkit.Models.TestNote
@{
    ViewData["Title"] = "Note Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text"></i> Note Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h4>@Model.Title</h4>
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.Status))
                    {
                        var statusClass = Model.Status switch { 
                            "Fixed" => "bg-success", 
                            "Posted" => "bg-primary", 
                            "Not Posted" => "bg-warning", 
                            "Not Fixed" => "bg-danger", 
                            _ => "bg-secondary" 
                        };
                        <span class="badge @statusClass">@Model.Status</span>
                    }
                </div>
                <table class="table table-borderless">
                    <tr><th style="width:120px">Project:</th><td>@(Model.Project ?? "-")</td></tr>
                    <tr><th>Server:</th><td>@(Model.Server ?? "-")</td></tr>
                    <tr><th>Created:</th><td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td></tr>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <tr><th>Updated:</th><td>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</td></tr>
                    }
                </table>
                <hr />
                <h5>Description</h5>
                <pre class="bg-light p-3 rounded">@Model.Description</pre>
                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <h5 class="mt-3">Remarks</h5>
                    <pre class="bg-light p-3 rounded">@Model.Remarks</pre>
                }
                @if (!string.IsNullOrEmpty(Model.ImageVideoUrl))
                {
                    <h5 class="mt-3">Media</h5>
                    <a href="@Model.ImageVideoUrl" target="_blank" class="btn btn-primary">
                        <i class="bi bi-link-45deg"></i> Open Media Link
                    </a>
                }
            </div>
            <div class="card-footer">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this note?');">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
