@model IEnumerable<QAToolkit.Models.ScheduledRun>
@{
    ViewData["Title"] = "Scheduled Runs";
    var scriptNames = ViewBag.ScriptNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<style>
    .schedules-page { background: #0d1117; min-height: 100vh; padding: 1.5rem; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
    .page-title { color: #e6edf3; font-size: 1.4rem; font-weight: 600; margin: 0; }
    .page-subtitle { color: #8b949e; font-size: 0.85rem; margin: 0.2rem 0 0; }
    .btn-new { background: #238636; border: 1px solid #2ea043; color: #e6edf3; padding: 0.45rem 1rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; transition: background 0.2s; }
    .btn-new:hover { background: #2ea043; color: #fff; text-decoration: none; }
    .schedules-table { background: #161b22; border: 1px solid #30363d; border-radius: 8px; overflow: hidden; }
    .table { margin: 0; color: #e6edf3; }
    .table thead th { background: #21262d; color: #8b949e; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #30363d; padding: 0.75rem 1rem; border-top: none; }
    .table tbody td { border-color: #21262d; padding: 0.75rem 1rem; vertical-align: middle; }
    .table tbody tr:hover td { background: #1c2129; }
    .table tbody tr:last-child td { border-bottom: none; }
    .script-name { color: #58a6ff; font-weight: 500; font-size: 0.9rem; }
    .schedule-name { color: #e6edf3; font-weight: 500; }
    .schedule-meta { color: #8b949e; font-size: 0.78rem; margin-top: 0.15rem; }
    .badge-type { font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 20px; font-weight: 500; }
    .badge-once { background: #1f3a5f; color: #58a6ff; border: 1px solid #1f6feb; }
    .badge-daily { background: #1a3a2a; color: #3fb950; border: 1px solid #238636; }
    .badge-interval { background: #3a2a1a; color: #d29922; border: 1px solid #9e6a03; }
    .badge-status { font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 20px; font-weight: 500; }
    .status-ok { background: #1a3a2a; color: #3fb950; border: 1px solid #238636; }
    .status-error { background: #3a1a1a; color: #f85149; border: 1px solid #da3633; }
    .status-timeout { background: #3a2a1a; color: #d29922; border: 1px solid #9e6a03; }
    .status-running { background: #1f3a5f; color: #58a6ff; border: 1px solid #1f6feb; }
    .status-none { color: #484f58; font-size: 0.8rem; }
    .toggle-btn { background: none; border: 1px solid #30363d; color: #8b949e; padding: 0.25rem 0.6rem; border-radius: 5px; font-size: 0.75rem; cursor: pointer; transition: all 0.2s; }
    .toggle-btn.enabled { border-color: #238636; color: #3fb950; }
    .toggle-btn:hover { border-color: #58a6ff; color: #58a6ff; }
    .action-links { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .action-links a { color: #8b949e; font-size: 0.8rem; text-decoration: none; }
    .action-links a:hover { color: #58a6ff; }
    .action-links .del-btn { color: #8b949e; background: none; border: none; font-size: 0.8rem; cursor: pointer; padding: 0; }
    .action-links .del-btn:hover { color: #f85149; }
    .next-run { color: #8b949e; font-size: 0.8rem; }
    .next-run.soon { color: #d29922; }
    .next-run.due { color: #f85149; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #484f58; }
    .empty-state svg { width: 48px; height: 48px; opacity: 0.3; margin-bottom: 1rem; }
    .empty-state p { color: #8b949e; margin-bottom: 1rem; }
    .enabled-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 0.4rem; }
    .dot-on { background: #3fb950; }
    .dot-off { background: #484f58; }
</style>

<div class="schedules-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" style="background:#1a3a2a;border-color:#238636;color:#3fb950;" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" style="background:#3a1a1a;border-color:#da3633;color:#f85149;" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header">
        <div>
            <h1 class="page-title">Scheduled Runs</h1>
            <p class="page-subtitle">Automate script execution on a schedule</p>
        </div>
        <a href="/ScheduledRuns/Create" class="btn-new">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Schedule
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="schedules-table">
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                <p>No schedules yet. Create one to automate script runs.</p>
                <a href="/ScheduledRuns/Create" class="btn-new">Create Schedule</a>
            </div>
        </div>
    }
    else
    {
        <div class="schedules-table">
            <table class="table table-dark mb-0">
                <thead>
                    <tr>
                        <th style="width:36px"></th>
                        <th>Schedule</th>
                        <th>Script</th>
                        <th>Type</th>
                        <th>Next Run</th>
                        <th>Last Run</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var nextSoon = s.NextRunAt.HasValue && s.NextRunAt.Value <= DateTime.Now.AddHours(1);
                        var nextDue = s.NextRunAt.HasValue && s.NextRunAt.Value <= DateTime.Now;
                        <tr>
                            <td>
                                <span class="enabled-dot @(s.IsEnabled ? "dot-on" : "dot-off")" title="@(s.IsEnabled ? "Enabled" : "Disabled")"></span>
                            </td>
                            <td>
                                <div class="schedule-name">@s.Name</div>
                                @if (s.ScheduleType == "daily")
                                {
                                    <div class="schedule-meta">Daily at @s.DailyTime BD</div>
                                }
                                else if (s.ScheduleType == "interval")
                                {
                                    var iv = s.IntervalMinutes ?? 0;
                                    var ivText = iv >= 1440 ? $"Every {iv / 1440}d" : iv >= 60 ? $"Every {iv / 60}h" : $"Every {iv}m";
                                    <div class="schedule-meta">@ivText</div>
                                }
                                else if (s.RunOnce.HasValue)
                                {
                                    <div class="schedule-meta">@s.RunOnce.Value.ToString("dd MMM yyyy HH:mm")</div>
                                }
                            </td>
                            <td>
                                <a href="/PlaywrightScripts/Details/@s.ScriptId" class="script-name">
                                    @(scriptNames.TryGetValue(s.ScriptId, out var sn) ? sn : $"Script #{s.ScriptId}")
                                </a>
                            </td>
                            <td>
                                @if (s.ScheduleType == "once")
                                { <span class="badge-type badge-once">Once</span> }
                                else if (s.ScheduleType == "daily")
                                { <span class="badge-type badge-daily">Daily</span> }
                                else
                                { <span class="badge-type badge-interval">Interval</span> }
                            </td>
                            <td>
                                @if (s.NextRunAt.HasValue && s.IsEnabled)
                                {
                                    <span class="next-run @(nextDue ? "due" : nextSoon ? "soon" : "")">
                                        @s.NextRunAt.Value.ToString("dd MMM HH:mm")
                                    </span>
                                }
                                else if (!s.IsEnabled)
                                {
                                    <span class="status-none">Paused</span>
                                }
                                else
                                {
                                    <span class="status-none">—</span>
                                }
                            </td>
                            <td>
                                @if (s.LastRunStatus != null)
                                {
                                    <span class="badge-status status-@(s.LastRunStatus == "ok" ? "ok" : s.LastRunStatus == "running" ? "running" : s.LastRunStatus == "timeout" ? "timeout" : "error")">
                                        @s.LastRunStatus
                                    </span>
                                    if (s.LastRunAt.HasValue)
                                    {
                                        <div class="schedule-meta">@s.LastRunAt.Value.ToString("dd MMM HH:mm")</div>
                                    }
                                }
                                else
                                {
                                    <span class="status-none">Never</span>
                                }
                            </td>
                            <td>
                                <div class="action-links">
                                    <form asp-action="Toggle" asp-route-id="@s.Id" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="toggle-btn @(s.IsEnabled ? "enabled" : "")">
                                            @(s.IsEnabled ? "Pause" : "Enable")
                                        </button>
                                    </form>
                                    <a href="/ScheduledRuns/Edit/@s.Id">Edit</a>
                                    <a href="/ScheduledRuns/Logs/@s.Id">Logs</a>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('Delete this schedule and all its logs?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="del-btn">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
