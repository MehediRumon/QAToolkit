@model IEnumerable<QAToolkit.Models.ScheduledRunLog>
@{
    var schedule = ViewBag.Schedule as QAToolkit.Models.ScheduledRun;
    var scriptName = ViewBag.ScriptName as string ?? "";
    ViewData["Title"] = $"Logs — {schedule?.Name}";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb" class="mb-1">
            <ol class="breadcrumb mb-0" style="font-size:0.82rem">
                <li class="breadcrumb-item"><a asp-controller="ScheduledRuns" asp-action="Index">Scheduled Runs</a></li>
                <li class="breadcrumb-item active">@schedule?.Name</li>
            </ol>
        </nav>
        <h1>Run Logs</h1>
        <p class="text-muted">
            Script: <a asp-controller="PlaywrightScripts" asp-action="Details" asp-route-id="@schedule?.ScriptId" class="text-decoration-none">@scriptName</a>
            @if (schedule?.ScheduleType == "daily")
            { <span class="ms-2 text-muted small">· Daily at @schedule.DailyTime BD</span> }
            else if (schedule?.ScheduleType == "interval")
            {
                var iv = schedule.IntervalMinutes ?? 0;
                var ivText = iv >= 1440 ? $"Every {iv/1440}d" : iv >= 60 ? $"Every {iv/60}h" : $"Every {iv}m";
                <span class="ms-2 text-muted small">· @ivText</span>
            }
            else if (schedule?.RunOnce.HasValue == true)
            { <span class="ms-2 text-muted small">· Once at @schedule.RunOnce.Value.ToString("dd MMM yyyy HH:mm")</span> }
        </p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Edit" asp-route-id="@schedule?.Id" class="btn btn-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Schedule
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-journal-text" style="font-size: 2.5rem; color: var(--gray-300);"></i>
            <p class="mt-3 text-muted">No runs yet. The scheduler will log results here once the script executes.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Started</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Exit</th>
                        <th>Output</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap small text-muted">@log.StartedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td>
                                @if (log.Status == "ok")
                                { <span class="status-badge status-success"><span class="status-dot"></span>ok</span> }
                                else if (log.Status == "error")
                                { <span class="status-badge status-danger"><span class="status-dot"></span>error</span> }
                                else if (log.Status == "timeout")
                                { <span class="status-badge status-warning"><span class="status-dot"></span>timeout</span> }
                                else if (log.Status == "running")
                                { <span class="status-badge status-info"><span class="status-dot"></span>running</span> }
                                else
                                { <span class="text-muted small">@log.Status</span> }
                            </td>
                            <td class="small text-nowrap">
                                @if (log.DurationMs >= 60000)
                                { <span>@($"{log.DurationMs / 60000}m {(log.DurationMs % 60000) / 1000}s")</span> }
                                else if (log.DurationMs >= 1000)
                                { <span>@($"{log.DurationMs / 1000.0:F1}s")</span> }
                                else
                                { <span>@($"{log.DurationMs}ms")</span> }
                            </td>
                            <td class="small">
                                @if (log.ExitCode.HasValue)
                                {
                                    <code class="@(log.ExitCode == 0 ? "text-success" : "text-danger")">@log.ExitCode</code>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td style="max-width:520px">
                                @if (!string.IsNullOrEmpty(log.Output))
                                {
                                    var logId = $"out-{log.Id}";
                                    <pre id="@logId" class="log-output mb-1">@log.Output</pre>
                                    <button class="btn btn-ghost btn-sm py-0 px-1" style="font-size:0.75rem" onclick="toggleOutput('@logId', this)">Show more</button>
                                }
                                else
                                {
                                    <span class="text-muted small">(no output)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .log-output {
        font-size: 0.73rem;
        max-height: 90px;
        overflow: hidden;
        background: var(--surface-secondary, #f6f8fa);
        border: 1px solid var(--border-color, #e0e0e0);
        border-radius: 4px;
        padding: 0.4rem 0.6rem;
        white-space: pre-wrap;
        word-break: break-all;
        margin: 0;
        cursor: pointer;
    }
    .log-output.expanded { max-height: none; }
</style>

<script>
function toggleOutput(id, btn) {
    const el = document.getElementById(id);
    const expanded = el.classList.toggle('expanded');
    btn.textContent = expanded ? 'Show less' : 'Show more';
}
</script>
