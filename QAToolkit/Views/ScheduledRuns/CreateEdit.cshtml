@model QAToolkit.Models.ScheduledRun?
@using QAToolkit.Models
@{
    var isEdit = Model != null;
    ViewData["Title"] = isEdit ? "Edit Schedule" : "New Schedule";
    var scripts = ViewBag.Scripts as List<PlaywrightScript> ?? new List<PlaywrightScript>();
    var preselected = (int?)ViewBag.PreselectedScriptId;
}

<style>
    .form-page { background: #0d1117; min-height: 100vh; padding: 1.5rem; }
    .form-card { background: #161b22; border: 1px solid #30363d; border-radius: 10px; max-width: 680px; margin: 0 auto; overflow: hidden; }
    .form-card-header { background: #21262d; border-bottom: 1px solid #30363d; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; }
    .form-card-title { color: #e6edf3; font-size: 1rem; font-weight: 600; margin: 0; }
    .form-card-body { padding: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { color: #8b949e; font-size: 0.82rem; font-weight: 500; margin-bottom: 0.4rem; display: block; text-transform: uppercase; letter-spacing: 0.04em; }
    .form-control, .form-select { background: #0d1117; border: 1px solid #30363d; color: #e6edf3; border-radius: 6px; padding: 0.5rem 0.75rem; font-size: 0.9rem; width: 100%; transition: border-color 0.2s; }
    .form-control:focus, .form-select:focus { border-color: #58a6ff; background: #0d1117; color: #e6edf3; box-shadow: 0 0 0 3px rgba(88,166,255,0.1); outline: none; }
    .form-control::placeholder { color: #484f58; }
    textarea.form-control { resize: vertical; font-family: 'Courier New', monospace; font-size: 0.83rem; min-height: 90px; }
    .schedule-type-tabs { display: flex; gap: 0.5rem; margin-bottom: 0; }
    .type-tab { flex: 1; padding: 0.6rem; border: 1px solid #30363d; border-radius: 6px; background: #0d1117; color: #8b949e; cursor: pointer; text-align: center; font-size: 0.85rem; transition: all 0.2s; user-select: none; }
    .type-tab.active { border-color: #58a6ff; background: #1f3a5f; color: #58a6ff; }
    .type-tab:hover:not(.active) { border-color: #484f58; color: #e6edf3; }
    .schedule-section { display: none; padding-top: 1.25rem; }
    .schedule-section.visible { display: block; }
    .hint { color: #484f58; font-size: 0.78rem; margin-top: 0.3rem; }
    .form-actions { display: flex; gap: 0.75rem; padding-top: 0.5rem; }
    .btn-submit { background: #238636; border: 1px solid #2ea043; color: #e6edf3; padding: 0.5rem 1.25rem; border-radius: 6px; font-size: 0.9rem; cursor: pointer; transition: background 0.2s; font-weight: 500; }
    .btn-submit:hover { background: #2ea043; }
    .btn-cancel { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 0.5rem 1.25rem; border-radius: 6px; font-size: 0.9rem; text-decoration: none; display: inline-flex; align-items: center; transition: all 0.2s; }
    .btn-cancel:hover { border-color: #484f58; color: #e6edf3; text-decoration: none; }
    .interval-row { display: flex; gap: 0.5rem; align-items: flex-start; }
    .interval-input { width: 120px; flex-shrink: 0; }
    .interval-select { flex: 1; }
    .preset-btns { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem; }
    .preset-btn { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 0.25rem 0.6rem; border-radius: 5px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s; }
    .preset-btn:hover { border-color: #58a6ff; color: #58a6ff; }
    .error-msg { color: #f85149; background: #3a1a1a; border: 1px solid #da3633; border-radius: 6px; padding: 0.6rem 0.9rem; font-size: 0.85rem; margin-bottom: 1rem; }
</style>

<div class="form-page">
    <div class="form-card">
        <div class="form-card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#58a6ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <h2 class="form-card-title">@(isEdit ? "Edit Schedule" : "New Schedule")</h2>
        </div>
        <div class="form-card-body">
            @if (TempData["Error"] != null)
            {
                <div class="error-msg">@TempData["Error"]</div>
            }

            <form method="post" action="/ScheduledRuns/@(isEdit ? $"Edit/{Model!.Id}" : "Create")">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Schedule Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Daily smoke test" required
                           value="@(Model?.Name ?? "")" />
                </div>

                <div class="form-group">
                    <label class="form-label">Script</label>
                    <select name="scriptId" class="form-select" required>
                        <option value="">— select a script —</option>
                        @foreach (var sc in scripts)
                        {
                            var sel = (Model?.ScriptId == sc.Id) || (!isEdit && preselected == sc.Id);
                            <option value="@sc.Id" selected="@sel">@sc.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Schedule Type</label>
                    <div class="schedule-type-tabs">
                        <div class="type-tab @(Model?.ScheduleType == "once" || !isEdit ? "active" : "")" data-type="once" onclick="selectType('once')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            One-time
                        </div>
                        <div class="type-tab @(Model?.ScheduleType == "daily" ? "active" : "")" data-type="daily" onclick="selectType('daily')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            Daily
                        </div>
                        <div class="type-tab @(Model?.ScheduleType == "interval" ? "active" : "")" data-type="interval" onclick="selectType('interval')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                            Interval
                        </div>
                    </div>
                    <input type="hidden" name="scheduleType" id="scheduleTypeInput" value="@(Model?.ScheduleType ?? "once")" />
                </div>

                <!-- One-time section -->
                <div class="schedule-section @(Model == null || Model.ScheduleType == "once" ? "visible" : "")" id="section-once">
                    <div class="form-group">
                        <label class="form-label">Run At (Bangladesh Time)</label>
                        <input type="datetime-local" name="runOnce" class="form-control" id="runOnceInput"
                               value="@(Model?.RunOnce?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                        <p class="hint">The script will run once at this time, then be disabled.</p>
                    </div>
                </div>

                <!-- Daily section -->
                <div class="schedule-section @(Model?.ScheduleType == "daily" ? "visible" : "")" id="section-daily">
                    <div class="form-group">
                        <label class="form-label">Time of Day (BD Time, HH:MM)</label>
                        <input type="time" name="dailyTime" class="form-control" style="max-width:160px"
                               value="@(Model?.DailyTime ?? "09:00")" />
                        <p class="hint">Runs every day at this time (Bangladesh Standard Time).</p>
                    </div>
                </div>

                <!-- Interval section -->
                <div class="schedule-section @(Model?.ScheduleType == "interval" ? "visible" : "")" id="section-interval">
                    <div class="form-group">
                        <label class="form-label">Repeat Every</label>
                        <div class="interval-row">
                            <input type="number" name="intervalMinutes" id="intervalMinutes" class="form-control interval-input"
                                   min="1" max="10080" placeholder="30"
                                   value="@(Model?.IntervalMinutes?.ToString() ?? "")" />
                            <span style="color:#8b949e;font-size:0.9rem;padding-top:0.55rem">minutes</span>
                        </div>
                        <div class="preset-btns">
                            <button type="button" class="preset-btn" onclick="setInterval(15)">15 min</button>
                            <button type="button" class="preset-btn" onclick="setInterval(30)">30 min</button>
                            <button type="button" class="preset-btn" onclick="setInterval(60)">1 hour</button>
                            <button type="button" class="preset-btn" onclick="setInterval(120)">2 hours</button>
                            <button type="button" class="preset-btn" onclick="setInterval(360)">6 hours</button>
                            <button type="button" class="preset-btn" onclick="setInterval(720)">12 hours</button>
                            <button type="button" class="preset-btn" onclick="setInterval(1440)">24 hours</button>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Parameters (JSON) <span style="color:#484f58;font-weight:400;text-transform:none">— optional, overrides script defaults</span></label>
                    <textarea name="paramsJson" class="form-control" placeholder='{"key": "value"}' rows="4">@(Model?.ParamsJson ?? "")</textarea>
                    <p class="hint">Leave blank if the script has no parameters or uses its own defaults.</p>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">@(isEdit ? "Save Changes" : "Create Schedule")</button>
                    <a href="/ScheduledRuns" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function selectType(type) {
    document.querySelectorAll('.type-tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`.type-tab[data-type="${type}"]`).classList.add('active');
    document.getElementById('scheduleTypeInput').value = type;
    document.querySelectorAll('.schedule-section').forEach(s => s.classList.remove('visible'));
    document.getElementById(`section-${type}`).classList.add('visible');
}

function setInterval(mins) {
    document.getElementById('intervalMinutes').value = mins;
}

// Default the datetime-local min to now
(function() {
    const inp = document.getElementById('runOnceInput');
    if (inp && !inp.value) {
        const now = new Date();
        now.setMinutes(now.getMinutes() + 5);
        inp.value = now.toISOString().slice(0, 16);
    }
})();
</script>
