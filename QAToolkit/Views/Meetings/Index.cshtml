@model IEnumerable<QAToolkit.Models.Meeting>
@{
    ViewData["Title"] = "AI Meetings";
    var ingestUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/api/meetings/ingest";
    var pingUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/api/meetings/ping";
    var apiKey = ViewBag.ApiKey as string;
}

<div class="page-header">
    <div>
        <h1>AI Meetings</h1>
        <p>Summaries, transcripts and screen notes pushed from the AI meeting desktop app.</p>
    </div>
    <div class="page-header-actions">
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#apiInfoPanel">
            <i class="bi bi-plug"></i> Connect Desktop App
        </button>
    </div>
</div>

<!-- API connection info -->
<div class="collapse mb-3" id="apiInfoPanel">
    <div class="card">
        <div class="card-body">
            <h6 class="mb-3"><i class="bi bi-plug"></i> Desktop App Connection</h6>
            <div class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label small text-muted mb-1">Ingest endpoint (POST)</label>
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" class="form-control font-monospace" value="@ingestUrl" readonly>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@ingestUrl', this)"><i class="bi bi-clipboard"></i></button>
                    </div>
                    <label class="form-label small text-muted mb-1">Connectivity test (GET)</label>
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" class="form-control font-monospace" value="@pingUrl" readonly>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@pingUrl', this)"><i class="bi bi-clipboard"></i></button>
                    </div>
                    <label class="form-label small text-muted mb-1">API key (send as <code>X-Api-Key</code> header)</label>
                    <div class="input-group input-group-sm">
                        <input type="password" class="form-control font-monospace" value="@apiKey" readonly id="apiKeyField">
                        <button class="btn btn-outline-secondary" type="button" onclick="var f=document.getElementById('apiKeyField'); f.type = f.type==='password'?'text':'password';"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@apiKey', this)"><i class="bi bi-clipboard"></i></button>
                    </div>
                </div>
                <div class="col-lg-6">
                    <label class="form-label small text-muted mb-1">Sample JSON payload</label>
<pre class="mb-0 p-2 rounded border small" style="max-height: 260px; overflow: auto;"><code>{
  "uuid": "a1b2c3-unique-meeting-id",
  "title": "Sprint planning",
  "meetingDate": "2026-07-12T10:30:00",
  "durationMinutes": 45,
  "participants": "Rumon, Team",
  "source": "MeetingApp v1.0",
  "summary": "Key decisions...",
  "transcript": "Full transcript text...",
  "screenNotes": [
    {
      "capturedAt": "2026-07-12T10:35:00",
      "note": "Dashboard bug shown on screen",
      "imageFileName": "capture1.png",
      "imageBase64": "iVBORw0KGgo..."
    }
  ]
}</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="toolbar">
    <span class="toolbar-label">Search</span>
    <input type="text" name="search" class="form-control" style="max-width: 260px;" placeholder="Title, summary, participants..." value="@ViewBag.Search" />
    <span class="toolbar-label">Source</span>
    <select name="source" class="form-select">
        <option value="">All</option>
        @foreach (var src in ViewBag.Sources as List<string?>)
        {
            <option value="@src" selected="@(ViewBag.SelectedSource == src)">@src</option>
        }
    </select>
    <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
    <a href="/Meetings" class="btn btn-sm btn-ghost">Clear</a>
</form>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle" style="width: 3%">#</th>
                        <th class="align-middle" style="width: 25%">Title</th>
                        <th class="text-center align-middle" style="width: 12%">Date</th>
                        <th class="text-center align-middle" style="width: 7%">Duration</th>
                        <th class="align-middle" style="width: 18%">Participants</th>
                        <th class="text-center align-middle" style="width: 8%">Screen Notes</th>
                        <th class="text-center align-middle" style="width: 10%">Source</th>
                        <th class="text-center align-middle" style="width: 10%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var index = 1;
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center align-middle">@index</td>
                                <td class="align-middle">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-medium text-decoration-none">@item.Title</a>
                                    @if (!string.IsNullOrEmpty(item.Summary))
                                    {
                                        <div><small class="text-muted">@(item.Summary.Length > 90 ? item.Summary.Substring(0, 90) + "..." : item.Summary)</small></div>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <small>@item.MeetingDate.ToString("MMM dd, yyyy HH:mm")</small>
                                </td>
                                <td class="text-center align-middle">
                                    <small>@(item.DurationMinutes.HasValue ? $"{item.DurationMinutes} min" : "-")</small>
                                </td>
                                <td class="align-middle">
                                    <small>@(string.IsNullOrEmpty(item.Participants) ? "-" : item.Participants)</small>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.ScreenNotes.Count > 0)
                                    {
                                        <span class="badge bg-info"><i class="bi bi-images"></i> @item.ScreenNotes.Count</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrEmpty(item.Source))
                                    {
                                        <span class="badge bg-secondary">@item.Source</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                              data-confirm="Delete this meeting and all its screen notes? This action cannot be undone." data-confirm-title="Delete meeting">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state-icon"><i class="bi bi-camera-video"></i></div>
                                    <h5>No meetings received yet</h5>
                                    <p>Point the AI meeting desktop app at the ingest endpoint and it will appear here.</p>
                                    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#apiInfoPanel">
                                        <i class="bi bi-plug"></i> Show Connection Info
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
