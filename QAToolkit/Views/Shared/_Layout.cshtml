<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QA Toolkit</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/">
                <i class="bi bi-clipboard-check-fill text-primary"></i> 
                <span class="ms-2">QA Toolkit</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-3">
                        <span class="nav-link py-0">
                            <i class="bi bi-clock me-1 opacity-75"></i> 
                            <small class="fw-medium">@DateTime.Now.ToString("dddd, MMM dd")</small>
                        </span>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item border-start ps-3 ms-1 d-flex align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                                    @(User.Identity.Name?.Substring(0,1).ToUpper() ?? "U")
                                </div>
                                <span class="fw-medium text-dark small">@User.Identity.Name</span>
                            </div>
                        </li>
                        <li class="nav-item ms-3">
                            <a class="btn btn-sm btn-outline-danger border-0" asp-controller="Account" asp-action="Logout" title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="d-flex flex-column h-100">
            <ul class="nav flex-column flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-fill"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UrlResources" ? "active" : "")"
                       asp-controller="UrlResources" asp-action="Index">
                        <i class="bi bi-link-45deg"></i> URL Manager
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TestNotes" ? "active" : "")"
                       asp-controller="TestNotes" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Test Notes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Credentials" ? "active" : "")"
                       asp-controller="Credentials" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> Credentials
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ReleaseNotes" ? "active" : "")"
                       asp-controller="ReleaseNotes" asp-action="Index">
                        <i class="bi bi-rocket-takeoff"></i> Release Notes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MeetingNotes" ? "active" : "")"
                       asp-controller="MeetingNotes" asp-action="Index">
                        <i class="bi bi-people"></i> Meeting Notes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workflows" ? "active" : "")"
                       asp-controller="Workflows" asp-action="Index">
                        <i class="bi bi-diagram-3"></i> Workflows
                    </a>
                </li>
                <!-- Tools Section -->
                <li class="nav-item mt-4 mb-2">
                    <div class="nav-section-header text-uppercase text-muted fw-bold small px-3">
                        Tools
                    </div>
                </li>

                @{
                    var isOmrFiller = ViewContext.RouteData.Values["action"]?.ToString() == "OmrFiller";
                    var isConfigManager = ViewContext.RouteData.Values["action"]?.ToString() == "ConfigManager";
                    var isCsvGenerator = ViewContext.RouteData.Values["action"]?.ToString() == "CsvGenerator";
                    var isQuestionGenerator = ViewContext.RouteData.Values["action"]?.ToString() == "QuestionGenerator";
                    var isPaymentApproval = ViewContext.RouteData.Values["action"]?.ToString() == "PaymentApproval";
                    var omrExpanded = (isOmrFiller || isConfigManager) ? "true" : "false";
                    var omrShow = (isOmrFiller || isConfigManager) ? "show" : "";
                }
                <li class="nav-item">
                    <a class="nav-link @(isOmrFiller || isConfigManager ? "" : "collapsed")"
                       data-bs-toggle="collapse" href="#omrSubmenu" role="button"
                       aria-expanded="@omrExpanded" aria-controls="omrSubmenu">
                        <i class="bi bi-tools"></i>
                        <span class="flex-grow-1">OMR Auto Filler</span>
                        <i class="bi bi-chevron-down ms-auto small opacity-50"></i>
                    </a>
                    <div class="collapse @omrShow" id="omrSubmenu">
                        <ul class="submenu nav flex-column mt-1">
                            <li class="nav-item">
                                <a class="nav-link @(isOmrFiller ? "active" : "")"
                                   asp-controller="Tools" asp-action="OmrFiller">
                                    Process
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isConfigManager ? "active" : "")"
                                   asp-controller="Tools" asp-action="ConfigManager">
                                    Config Manager
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(isCsvGenerator ? "active" : "")"
                       asp-controller="Tools" asp-action="CsvGenerator">
                        <i class="bi bi-file-earmark-spreadsheet"></i> CSV Generator
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(isQuestionGenerator ? "active" : "")"
                       asp-controller="Tools" asp-action="QuestionGenerator">
                        <i class="bi bi-file-earmark-richtext"></i> Question Generator
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(isPaymentApproval ? "active" : "")"
                       asp-controller="Tools" asp-action="PaymentApproval">
                        <i class="bi bi-cash-coin"></i> Payment Approval
                    </a>
                </li>

                <!-- Admin Section -->
                @if (User.Claims.FirstOrDefault(c => c.Type == "IsSuperAdmin")?.Value == "True")
                {
                    <li class="nav-item mt-4 mb-2">
                        <div class="nav-section-header text-uppercase text-muted fw-bold small px-3">
                            Administration
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                           asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people-fill"></i> User Management
                        </a>
                    </li>
                }
            </ul>
            
            <div class="p-3 text-center text-muted small opacity-50">
                v1.0.0
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-3 mb-4" role="alert">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert-dismissible').forEach(function(alert) {
                setTimeout(function() {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 5000);
            });
        });

        // Copy to clipboard function with improved feedback
        function copyToClipboard(text, btn) {
            navigator.clipboard.writeText(text).then(function() {
                var originalHtml = btn.innerHTML;
                var icon = btn.querySelector('i');
                if(icon) {
                    var originalClass = icon.className;
                    icon.className = 'bi bi-check-lg text-success';
                    setTimeout(function() {
                        icon.className = originalClass;
                    }, 1500);
                } else {
                    btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                    setTimeout(function() {
                        btn.innerHTML = originalHtml;
                    }, 1500);
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
