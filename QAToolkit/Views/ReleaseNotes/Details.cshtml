@model QAToolkit.Models.ReleaseNote
@{
    ViewData["Title"] = "Release Details";
}

<div class="page-header no-print">
    <div>
        <h1>@Model.Title</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            <span class="badge bg-info">v@Model.Version</span>
            <span class="badge bg-secondary">@Model.Project</span>
            <span class="text-muted small">
                <i class="bi bi-calendar3"></i> @Model.ReleaseDate.ToString("MMMM dd, yyyy")
            </span>
        </div>
    </div>
    <div class="page-header-actions">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="detail-section">
    <div class="detail-section-title"><i class="bi bi-stars"></i> New Features</div>
    <div class="detail-content">@Model.Features</div>
</div>

@if (!string.IsNullOrEmpty(Model.BugFixes))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-bug"></i> Bug Fixes</div>
        <div class="detail-content">@Model.BugFixes</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.KnownIssues))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-exclamation-triangle"></i> Known Issues</div>
        <div class="detail-content">@Model.KnownIssues</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.TestingNotes))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-clipboard-check"></i> Testing Notes</div>
        <div class="detail-content">@Model.TestingNotes</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.TestingStatus))
{
    <div class="detail-section">
        <div class="detail-section-title"><i class="bi bi-check2-all"></i> Testing Status</div>
        <div class="detail-content">@Model.TestingStatus</div>
    </div>
}

<div class="detail-footer no-print">
    <div class="detail-footer-item">
        <span class="label">Created By</span>
        <span class="value">@(Model.CreatedBy ?? "N/A") &middot; @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.ModifiedBy) || Model.ModifiedAt.HasValue)
    {
        <div class="detail-footer-item">
            <span class="label">Modified By</span>
            <span class="value">@(Model.ModifiedBy ?? "—") &middot; @(Model.ModifiedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</span>
        </div>
    }
</div>
