@model QAToolkit.Models.ReleaseNote
@{
    ViewData["Title"] = "Release Details";
}

<style>
    @@media print {
        /* Hide layout elements */
        .navbar, .sidebar, .no-print, .card-footer, .meta-info {
            display: none !important;
            visibility: hidden !important;
        }
        /* Reset main content positioning */
        .main-content {
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
        }
        /* Full width print area */
        .print-area {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 15px !important;
            background: white !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
            width: 100% !important;
        }
        .row, .col-md-10 {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        /* Fix pre element scrolling */
        pre {
            white-space: pre-wrap !important;
            word-wrap: break-word !important;
            overflow: visible !important;
            max-width: 100% !important;
        }
        /* Ensure content is visible */
        body {
            background: white !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h2><i class="bi bi-rocket-takeoff"></i> Release Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row">
    <div class="col-md-10">
        <div class="card print-area">
            <div class="card-header">
                <h4 class="mb-2">@Model.Title</h4>
                <div class="text-muted">
                    <span class="me-3"><strong>Version:</strong> @Model.Version</span>
                    <span class="me-3"><strong>Project:</strong> @Model.Project</span>
                    <span><strong>Release Date:</strong> @Model.ReleaseDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
            <div class="card-body">

                <hr />
                <h5><i class="bi bi-star"></i> New Features</h5>
                <pre class="bg-light p-3 rounded">@Model.Features</pre>

                @if (!string.IsNullOrEmpty(Model.BugFixes))
                {
                    <h5><i class="bi bi-bug"></i> Bug Fixes</h5>
                    <pre class="bg-light p-3 rounded">@Model.BugFixes</pre>
                }

                @if (!string.IsNullOrEmpty(Model.KnownIssues))
                {
                    <h5><i class="bi bi-exclamation-triangle"></i> Known Issues</h5>
                    <pre class="bg-light p-3 rounded">@Model.KnownIssues</pre>
                }

                @if (!string.IsNullOrEmpty(Model.TestingNotes))
                {
                    <h5><i class="bi bi-clipboard-check"></i> Testing Notes</h5>
                    <pre class="bg-light p-3 rounded">@Model.TestingNotes</pre>
                }

                @if (!string.IsNullOrEmpty(Model.TestingStatus))
                {
                    <h5><i class="bi bi-check2-all"></i> Testing Status</h5>
                    <pre class="bg-light p-3 rounded">@Model.TestingStatus</pre>
                }

                <hr class="meta-info" />
                <div class="row mt-4 meta-info">
                    <div class="col-md-6">
                        <h6 class="text-muted"><i class="bi bi-person-plus"></i> Created By</h6>
                        <p>@(Model.CreatedBy ?? "N/A")</p>
                        <h6 class="text-muted"><i class="bi bi-calendar-plus"></i> Creation Date</h6>
                        <p>@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted"><i class="bi bi-person-check"></i> Modified By</h6>
                        <p>@(Model.ModifiedBy ?? "-")</p>
                        <h6 class="text-muted"><i class="bi bi-calendar-check"></i> Modification Date</h6>
                        <p>@(Model.ModifiedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "-")</p>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button onclick="window.print()" class="btn btn-secondary"><i class="bi bi-printer"></i> Print</button>
            </div>
        </div>
    </div>
</div>
