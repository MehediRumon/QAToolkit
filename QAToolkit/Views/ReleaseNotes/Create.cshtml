@model QAToolkit.Models.ReleaseNote
@{
    ViewData["Title"] = "Add Release Note";
}

<div class="page-header">
    <div><h1>Add Release Note</h1></div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-10">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Release Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Version" class="form-label">Version <span class="text-danger">*</span></label>
                            <input asp-for="Version" class="form-control" />
                            <span asp-validation-for="Version" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Project" class="form-label">Project <span class="text-danger">*</span></label>
                            <input asp-for="Project" class="form-control" />
                            <span asp-validation-for="Project" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReleaseDate" class="form-label">Release Date</label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Features" class="form-label">New Features <span class="text-danger">*</span></label>
                        <textarea asp-for="Features" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Features" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BugFixes" class="form-label">Bug Fixes</label>
                        <textarea asp-for="BugFixes" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="KnownIssues" class="form-label">Known Issues</label>
                        <textarea asp-for="KnownIssues" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TestingNotes" class="form-label">Testing Notes</label>
                        <textarea asp-for="TestingNotes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-info"><i class="bi bi-check-lg"></i> Save Release</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
