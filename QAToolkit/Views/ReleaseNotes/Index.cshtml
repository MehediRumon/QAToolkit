@model IEnumerable<QAToolkit.Models.ReleaseNote>
@{
    ViewData["Title"] = "Release Notes";
}

<div class="page-header">
    <div>
        <h1>Release Notes</h1>
        <p>Track release versions, new features, and testing status.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Release</a>
    </div>
</div>

<form method="get" class="toolbar">
    <span class="toolbar-label">Project</span>
    <select name="project" class="form-select">
        <option value="">All</option>
        @foreach (var proj in ViewBag.Projects as List<string>)
        {
            <option value="@proj" selected="@(ViewBag.SelectedProject == proj)">@proj</option>
        }
    </select>
    <input type="text" name="search" class="form-control" placeholder="Search title, version, features..." value="@ViewBag.SearchTerm" style="min-width: 240px;" />
    <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
    <a href="/ReleaseNotes" class="btn btn-sm btn-ghost">Clear</a>
</form>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center align-middle" style="width: 8%">Version</th>
                            <th class="text-center align-middle" style="width: 20%">Title</th>
                            <th class="text-center align-middle" style="width: 10%">Project</th>
                            <th class="text-center align-middle" style="width: 10%">Release Date</th>
                            <th class="text-center align-middle" style="width: 24%">Features</th>
                            <th class="text-center align-middle" style="width: 10%">Created By</th>
                            <th class="text-center align-middle" style="width: 10%">Modified By</th>
                            <th class="text-center align-middle" style="width: 8%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="cursor: pointer;" onclick="window.location='@Url.Action("Details", new { id = item.Id })'">
                                <td class="text-center align-middle">
                                    <span class="badge bg-info">@item.Version</span>
                                </td>
                                <td class="align-middle"><strong>@item.Title</strong></td>
                                <td class="text-center align-middle">@item.Project</td>
                                <td class="text-center align-middle"><small>@item.ReleaseDate.ToString("MMM dd, yyyy")</small></td>
                                <td class="align-middle">
                                    <small>@(item.Features.Length > 150 ? item.Features.Substring(0, 150) + "..." : item.Features)</small>
                                </td>
                                <td class="text-center align-middle"><small>@(item.CreatedBy ?? "N/A")</small></td>
                                <td class="text-center align-middle"><small>@(item.ModifiedBy ?? "-")</small></td>
                                <td class="text-center align-middle text-nowrap" onclick="event.stopPropagation();">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.CreatedBy == User.Identity?.Name)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                onclick="if(confirm('Delete this release note?')) { document.getElementById('deleteForm-@item.Id').submit(); }">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <form id="deleteForm-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:none;">
                                            @Html.AntiForgeryToken()
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-rocket-takeoff"></i></div>
            <h5>No release notes yet</h5>
            <p>Track your first release version and features.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Release</a>
        </div>
    </div>
}

