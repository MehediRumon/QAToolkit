<style>
    .toc-link { color:var(--text-secondary); text-decoration:none; padding:.2rem .5rem; border-radius:4px; transition:background .15s,color .15s; }
    .toc-link:hover, .toc-link.active { background:var(--surface-overlay); color:var(--text-primary); }
    .toc-link code { font-size:.75rem; }

    .code-block { background:var(--surface-raised,#f6f8fa); border:1px solid var(--border-subtle); border-radius:8px; overflow:hidden; }
    [data-theme="dark"] .code-block { background:#0d1117; border-color:#30363d; }
    .code-block-header { display:flex; align-items:center; justify-content:space-between; background:var(--surface-overlay,#f0f2f4); border-bottom:1px solid var(--border-subtle); padding:.4rem .75rem; font-size:.8rem; color:var(--text-secondary); }
    [data-theme="dark"] .code-block-header { background:#161b22; border-bottom-color:#30363d; }
    .code-block pre { margin:0; padding:1rem; font-family:'Courier New',Consolas,monospace; font-size:12.5px; line-height:1.65; white-space:pre; overflow-x:auto; color:var(--text-primary); background:transparent; }
    [data-theme="dark"] .code-block pre { color:#c9d1d9; }
    .btn-copy { background:none; border:none; cursor:pointer; color:var(--text-secondary); padding:.1rem .3rem; border-radius:4px; font-size:.85rem; transition:color .15s; }
    .btn-copy:hover { color:var(--text-primary); }
</style>
<script>
    function copyCode(btn) {
        var pre = btn.closest('.code-block').querySelector('pre');
        if (!pre) return;
        navigator.clipboard.writeText(pre.textContent).then(function () {
            var icon = btn.querySelector('i');
            if (icon) { icon.className = 'bi bi-check-lg text-success'; setTimeout(function () { icon.className = 'bi bi-clipboard'; }, 1500); }
        });
    }

    function copyDeployChecklist() {
        var text = `QA Toolkit — Playwright Deployment Checklist

PREREQUISITES
- .NET >= 9.0  (dotnet --version)
- Node.js >= 18  (node --version)
- npm >= 9  (npm --version)

WORKING DIRECTORY SETUP (default: D:\\Projects or /opt/qa-scripts)
  npm init -y
  npm install playwright
  npm install &#64;playwright/test --save-dev
  npx playwright install chromium
  npx playwright install-deps chromium   # Linux only

appsettings.json:
  "Playwright": {
    "WorkingDirectory": "D:\\\\Projects",
    "Headless": true,
    "TimeoutSeconds": 300
  }

LINUX EXTRA:
  sudo apt-get install -y libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2

VERIFY:
  node verify.js    (see guide for verify.js content)
  npx playwright test --version`;
        navigator.clipboard.writeText(text).then(function () {
            var btn = event.target.closest('button');
            var orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied!';
            setTimeout(function () { btn.innerHTML = orig; }, 2000);
        });
    }

    // TOC scroll highlight
    var sections = document.querySelectorAll('section[id]');
    var tocLinks = document.querySelectorAll('.toc-link');
    window.addEventListener('scroll', function () {
        var scrollY = window.scrollY + 100;
        var current = '';
        sections.forEach(function (s) { if (s.offsetTop <= scrollY) current = s.id; });
        tocLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + current); });
    }, { passive: true });
</script>
}
