<pre># Working directory তৈরি করো
mkdir D:\Projects          # Windows
mkdir -p /opt/qa-scripts   # Linux

# npm init (package.json না থাকলে)
cd D:\Projects
npm init -y

# playwright (node runner-এর জন্য)
npm install playwright

# &#64;playwright/test (TypeScript/playwright test runner-এর জন্য)
npm install &#64;playwright/test --save-dev

# Browser binaries download করো
npx playwright install chromium

# Linux-এ system dependencies লাগতে পারে
npx playwright install-deps chromium   # Linux only</pre>
