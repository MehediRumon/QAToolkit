    <!-- Main content -->
    <div class="col-lg-9">

        <!-- Overview -->
        <section id="overview" class="mb-5">
            <h4 class="fw-semibold mb-1">Overview</h4>
            <p class="text-muted small mb-3">সিস্টেম কিভাবে script execute করে এবং parameter auto-detect করে</p>
            <p class="text-muted">
                System টা <strong>Node.js</strong> দিয়ে script run করে। Script import করার সময় system automatically
                configurable parameter গুলো detect করে এবং <strong>form auto-generate</strong> করে — প্রতিবার run করার আগে
                শুধু value fill করলেই হবে, script edit করতে হবে না।
            </p>
            <div class="row g-3 mt-1">
                <div class="col-sm-6">
                    <div class="card h-100 border-0" style="background: var(--surface-raised);">
                        <div class="card-body">
                            <i class="bi bi-magic text-primary mb-2" style="font-size:1.4rem;"></i>
                            <h6 class="fw-semibold">Auto-detected patterns</h6>
                            <p class="text-muted small mb-0">৪টি script pattern automatically recognize করা হয় — কোনো extra configuration লাগে না।</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card h-100 border-0" style="background: var(--surface-raised);">
                        <div class="card-body">
                            <i class="bi bi-input-cursor-text text-primary mb-2" style="font-size:1.4rem;"></i>
                            <h6 class="fw-semibold">Smart field types</h6>
                            <p class="text-muted small mb-0">Password automatically mask হয়, boolean-এ checkbox আসে, array-এ JSON input আসে।</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card h-100 border-0" style="background: var(--surface-raised);">
                        <div class="card-body">
                            <i class="bi bi-browser-chrome text-primary mb-2" style="font-size:1.4rem;"></i>
                            <h6 class="fw-semibold">Page function shorthand</h6>
                            <p class="text-muted small mb-0">শুধু <code>async (page) =&gt; &#123;…&#125;</code> লিখলেই system টা full browser launcher দিয়ে wrap করে নেয়।</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card h-100 border-0" style="background: var(--surface-raised);">
                        <div class="card-body">
                            <i class="bi bi-save text-primary mb-2" style="font-size:1.4rem;"></i>
                            <h6 class="fw-semibold">Saved form values</h6>
                            <p class="text-muted small mb-0">Last enter করা values browser-এ save থাকে — একবার fill করলে বারবার করতে হয় না।</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="alert mt-4 mb-0" style="background:var(--color-info-subtle,#e7f3ff);border-color:var(--color-info,#0969da);color:var(--text-primary);">
                <strong>Detection priority:</strong>
                <code>__PARAMS__</code> → <code>process.argv</code> + Options comment → <code>const CONFIG = &#123;&#125;</code> → top-level <code>const UPPER = …</code>
            </div>
        </section>

        <hr class="my-4">

        <!-- Runner selection -->
        <section id="runner" class="mb-5">
            <h4 class="fw-semibold mb-1">Runner কোনটা বেছে নেব?</h4>
            <p class="text-muted small mb-3">Script import করার সময় <strong>Runner</strong> dropdown থেকে সঠিক runner select করতে হবে</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card h-100" style="border-color: var(--border-subtle);">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge badge-muted">node</span>
                                <h6 class="fw-semibold mb-0">Node.js Runner</h6>
                            </div>
                            <p class="text-muted small mb-2">কখন use করব:</p>
                            <ul class="text-muted small mb-0 ps-3">
                                <li><code>require('playwright')</code> দিয়ে লেখা script</li>
                                <li><code>async (page) =&gt; &#123;&#125;</code> page function shorthand</li>
                                <li>যেকোনো general purpose Node.js script</li>
                                <li><code>__PARAMS__</code>, <code>CONFIG</code>, constants pattern</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100" style="border-color: var(--color-success,#1a7f37);">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge badge-success">npx playwright test</span>
                                <h6 class="fw-semibold mb-0">Playwright Test Runner</h6>
                            </div>
                            <p class="text-muted small mb-2">কখন use করব:</p>
                            <ul class="text-muted small mb-0 ps-3">
                                <li><code>import &#123; test, expect &#125; from '&#64;playwright/test'</code> দিয়ে লেখা script</li>
                                <li>TypeScript (<code>.ts</code>) test files</li>
                                <li>Playwright Codegen দিয়ে record করা scripts</li>
                                <li><code>expect(locator).toBeVisible()</code> style assertions</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert mt-3 mb-0" style="background:var(--color-warning-subtle,#fff8c5);border-color:var(--color-warning,#d4a72c);color:var(--text-primary);">
                <i class="bi bi-lightbulb me-1"></i>
                <strong>Quick rule:</strong> Playwright Codegen বা VS Code Extension দিয়ে record করা script হলে <strong>npx playwright test</strong> runner select করো। নিজে লিখলে বা <code>require()</code> দিয়ে শুরু হলে <strong>node</strong> runner।
            </div>
        </section>

        <hr class="my-4">

        <!-- Pattern 1 -->
        <section id="pattern1" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-primary px-2 py-1">Pattern 1</span>
                <h4 class="fw-semibold mb-0">Template — <code>__PARAMS__</code></h4>
            </div>
            <p class="text-muted small mb-3">সবচেয়ে recommended pattern। Script-এ <code>__PARAMS__</code> token রাখো — runtime-এ system সেটা user-filled JSON দিয়ে replace করে দেবে।</p>

            <div class="mb-3">
                <h6 class="fw-semibold text-muted text-uppercase small mb-2" style="letter-spacing:.05em;">Options comment format</h6>
                <div class="code-block">
                    <div class="code-block-header"><span>comment syntax</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>// Options:
//   fieldName     Description                    (default: 'value')
//   count         কতটা process করবে              (default: 10)
//   mode          Run mode 'fast'|'slow'|'debug' (default: 'fast')</pre>
                </div>
            </div>

            <div class="mb-2">
                <h6 class="fw-semibold text-muted text-uppercase small mb-2" style="letter-spacing:.05em;">Full example</h6>
                <div class="code-block">
                    <div class="code-block-header"><span>login-test.js</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>// Options:
//   url        Portal URL                   (default: 'https://school.edu/login')
//   username   Login username               (default: 'admin')
//   password   Login password
//   headless   Browser hide রাখবে কিনা     (default: true)

async (page) => {
    const { url, username, password } = __PARAMS__;

    await page.goto(url);
    await page.fill('#username', username);
    await page.fill('#password', password);
    await page.click('button[type="submit"]');
    await page.waitForURL('**/dashboard**', { timeout: 10000 });
    console.log('Login successful');
}</pre>
                </div>
            </div>
            <div class="alert mt-3 mb-0" style="background:var(--color-warning-subtle,#fff8c5);border-color:var(--color-warning,#d4a72c);color:var(--text-primary);">
                <i class="bi bi-info-circle me-1"></i>
                <code>__PARAMS__</code> থাকলে কিন্তু form fill না করলে system run করবে না — "fill in the Parameters panel" message দেবে।
            </div>
        </section>

        <hr class="my-4">

        <!-- Pattern 2 -->
        <section id="pattern2" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-primary px-2 py-1">Pattern 2</span>
                <h4 class="fw-semibold mb-0">CLI Style — <code>process.argv</code></h4>
            </div>
            <p class="text-muted small mb-3">যে scripts originally terminal থেকে run করার জন্য লেখা। System <code>// Options:</code> comment পড়ে <code>process.argv</code> shim তৈরি করে দেয়।</p>

            <div class="mb-3">
                <div class="code-block">
                    <div class="code-block-header"><span>admission-blast.js</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>// Usage:
//   node script.js &lt;mobile&gt; [options]
//
// Options:
//   -s &lt;servers&gt;         Parallel worker count       (default: 5)
//   --session &lt;session&gt;  Academic session year       (default: '2024')
//   --attempts &lt;count&gt;   Max retry attempts          (default: 3)

const mobile  = process.argv[2];
const servers = parseInt(process.argv[process.argv.indexOf('-s') + 1] || '5');
const session = process.argv[process.argv.indexOf('--session') + 1] || '2024';

console.log(`Running for ${mobile}: ${servers} workers, session ${session}`);</pre>
                </div>
            </div>
            <div class="alert mt-3 mb-0" style="background:var(--color-warning-subtle,#fff8c5);border-color:var(--color-warning,#d4a72c);color:var(--text-primary);">
                <i class="bi bi-info-circle me-1"></i>
                Script-এ <strong>দুটো জিনিস একসাথে থাকতে হবে</strong>: <code>process.argv</code> এবং <code>// Options:</code> comment line।
            </div>
        </section>

        <hr class="my-4">

        <!-- Pattern 3 -->
        <section id="pattern3" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-primary px-2 py-1">Pattern 3</span>
                <h4 class="fw-semibold mb-0">Config Object — <code>const CONFIG = &#123;&#125;</code></h4>
            </div>
            <p class="text-muted small mb-3">Complex script-এর জন্য সবচেয়ে clean pattern। Script-এর top-এ একটা <code>const CONFIG</code> block রাখো — system পুরো block টা replace করে দেবে।</p>

            <div class="code-block">
                <div class="code-block-header"><span>evaluation-entry.js</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>const CONFIG = {
    org:             'ONLINE CARE',
    examQuery:       'HSC 2024',
    session:         '2024',
    subjects:        ['Physics', 'Chemistry', 'Biology'],
    teacherCount:    5,
    entriesPerTeacher: 20,
    passMark:        33,
    baseUrl:         'https://app.example.com',
    username:        'admin',
    password:        'secret',
};

const { org, subjects, teacherCount } = CONFIG;
console.log(`Org: ${org}, teachers: ${teacherCount}`);</pre>
            </div>
            <div class="alert mt-3 mb-0" style="background:var(--color-info-subtle,#e7f3ff);border-color:var(--color-info,#0969da);color:var(--text-primary);">
                <i class="bi bi-info-circle me-1"></i>
                <code>const CONFIG</code> block টা অবশ্যই <code>&#125;;</code> দিয়ে শেষ হতে হবে — নিজের line-এ।
            </div>
        </section>

        <hr class="my-4">

        <!-- Pattern 4 -->
        <section id="pattern4" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-primary px-2 py-1">Pattern 4</span>
                <h4 class="fw-semibold mb-0">Top-level Constants — <code>const UPPER = …</code></h4>
            </div>
            <p class="text-muted small mb-3">সবচেয়ে simple pattern — কোনো special syntax নেই। Top-level <strong>ALL_CAPS বা PascalCase</strong> constant গুলো automatically detect হয়।</p>

            <div class="code-block">
                <div class="code-block-header"><span>see-exam.js</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>const BASE_URL  = 'https://ums.school.edu';
const USERNAME  = 'admin';
const PASSWORD  = 'secret123';
const SESSION   = '2024';
const EXAM_NAME = 'SSC 2024';
const PASS_MARK = 33;
const SUBJECTS  = ['Bangla', 'English', 'Math'];

const { chromium } = require('playwright');
(async () => {
    const browser = await chromium.launch({ headless: true });
    const page = await browser.newPage();
    await page.goto(BASE_URL + '/login');
    console.log(`Running: ${EXAM_NAME}`);
    await browser.close();
})();</pre>
            </div>
            <div class="alert mt-3 mb-0" style="background:var(--color-warning-subtle,#fff8c5);border-color:var(--color-warning,#d4a72c);color:var(--text-primary);">
                <i class="bi bi-info-circle me-1"></i>
                শুধু <code>BASE_URL</code>, <code>PASSWORD</code> এর মতো ALL_CAPS বা <code>BaseUrl</code> এর মতো PascalCase নাম detect হবে। <code>baseUrl</code> এর মতো camelCase detect হবে না।
            </div>
        </section>

        <hr class="my-4">

        <!-- Pattern 5: @@playwright/test -->
        <section id="pwtest" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-success px-2 py-1">Pattern 5</span>
                <h4 class="fw-semibold mb-0">&#64;playwright/test — TypeScript Test Runner</h4>
            </div>
            <p class="text-muted small mb-3">Playwright Codegen বা VS Code Extension দিয়ে record করা scripts এই format-এ থাকে। Import করার সময় runner <strong>npx playwright test</strong> select করতে হবে।</p>

            <div class="mb-3">
                <div class="code-block">
                    <div class="code-block-header"><span>app-check.ts</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>import { test, expect } from '&#64;playwright/test';

test('login and verify dashboard', async ({ page }) => {
    await page.goto('https://app.example.com/login');

    await expect(page.getByRole('heading', { name: 'Login' })).toBeVisible();
    await page.getByTestId('username-input').fill('admin');
    await page.getByTestId('password-input').fill('secret');
    await page.getByTestId('login-button').click();

    await expect(page.getByTestId('dashboard-title')).toBeVisible();
    await expect(page.getByTestId('dashboard-title')).toContainText('Dashboard');
    console.log('✓ Login verified');
});

test('check live exam section', async ({ page }) => {
    // second test case...
});</pre>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-md-6">
                    <div class="card border-0" style="background:var(--surface-raised);">
                        <div class="card-body py-2 px-3">
                            <p class="fw-semibold small mb-1"><i class="bi bi-check-circle text-success me-1"></i>এই format এ যা কাজ করে</p>
                            <ul class="text-muted small mb-0 ps-3">
                                <li><code>expect().toBeVisible()</code></li>
                                <li><code>expect().toContainText()</code></li>
                                <li><code>page.getByTestId()</code></li>
                                <li><code>page.getByRole()</code></li>
                                <li>Multiple <code>test()</code> blocks</li>
                                <li>TypeScript types</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0" style="background:var(--surface-raised);">
                        <div class="card-body py-2 px-3">
                            <p class="fw-semibold small mb-1"><i class="bi bi-x-circle text-danger me-1"></i>এই format এ যা কাজ করবে না</p>
                            <ul class="text-muted small mb-0 ps-3">
                                <li><code>require()</code> syntax (use <code>import</code>)</li>
                                <li>Top-level <code>await</code> outside test block</li>
                                <li><code>process.argv</code> param injection</li>
                                <li>Page function shorthand</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <hr class="my-4">

        <!-- Page Function -->
        <section id="pagefn" class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background:var(--color-success);color:#fff;padding:.2rem .5rem;">Shorthand</span>
                <h4 class="fw-semibold mb-0">Page Function — <code>async (page) =&gt; &#123;…&#125;</code></h4>
            </div>
            <p class="text-muted small mb-3">Browser boilerplate লিখতে চাও না? শুধু page function লেখো — system নিজেই browser launch করে দেবে।</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <h6 class="fw-semibold text-muted text-uppercase small mb-2" style="letter-spacing:.05em;">তুমি যা লেখো</h6>
                    <div class="code-block h-100">
                        <div class="code-block-header"><span>short.js</span><button class="btn-copy" onclick="copyCode(this)"><i class="bi bi-clipboard"></i></button></div>
<pre>async (page) => {
    await page.goto('https://example.com');
    const title = await page.title();
    console.log('Title:', title);
}</pre>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="fw-semibold text-muted text-uppercase small mb-2" style="letter-spacing:.05em;">System যা run করে</h6>
                    <div class="code-block h-100" style="opacity:.75;">
                        <div class="code-block-header"><span>auto-wrapped</span></div>
<pre>const { chromium } = require('playwright');
const __fn = (async (page) => {
    await page.goto('https://example.com');
    const title = await page.title();
    console.log('Title:', title);
});
(async () => {
  const browser = await chromium.launch(...);
  const page = await browser.newPage();
  await __fn(page);
  await browser.close();
})();</pre>
                    </div>
                </div>
            </div>
        </section>

        <hr class="my-4">

        <!-- Field Types -->
        <section id="fieldtypes" class="mb-5">
            <h4 class="fw-semibold mb-1">Field Type Auto-Detection</h4>
            <p class="text-muted small mb-3">Variable নামের pattern দেখে system automatically সঠিক input type বেছে নেয়</p>

            <div class="card">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>নামের pattern</th>
                                <th>Example</th>
                                <th>UI</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge badge-danger">password</span></td>
                                <td>নামে <code>password</code> আছে</td>
                                <td><code>password</code>, <code>PASSWORD</code>, <code>dbPassword</code></td>
                                <td>Masked input + show/hide</td>
                            </tr>
                            <tr>
                                <td><span class="badge badge-info">boolean</span></td>
                                <td><code>is</code> বা <code>has</code> দিয়ে শুরু</td>
                                <td><code>isActive</code>, <code>hasAccess</code></td>
                                <td>Checkbox</td>
                            </tr>
                            <tr>
