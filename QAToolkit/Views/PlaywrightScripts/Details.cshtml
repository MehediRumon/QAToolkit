        const ic = document.getElementById('copyIcon');
        ic.className = 'bi bi-clipboard-check text-success';
        setTimeout(() => ic.className = 'bi bi-clipboard', 2000);
    });
});

document.getElementById('runBtn')?.addEventListener('click', doRun);
document.getElementById('runBtnBottom')?.addEventListener('click', doRun);
document.getElementById('stickyRunBtn')?.addEventListener('click', doRun);
document.getElementById('stickyStopBtn')?.addEventListener('click', () => document.getElementById('stopBtn')?.click());

// Ctrl/Cmd+Enter to run
document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        const btn = document.getElementById('stickyRunBtn') || document.getElementById('runBtn');
        if (btn && !btn.classList.contains('running')) { e.preventDefault(); btn.click(); }
    }
});

// Mirror terminal status/duration/exit + Run/Stop button state to the sticky bar.
(function setupStickyMirror() {
    const mirror = (srcId, dstId) => {
        const src = document.getElementById(srcId), dst = document.getElementById(dstId);
        if (!src || !dst) return;
        const sync = () => {
            dst.innerHTML = src.innerHTML;
            // For the exit badge, copy class to inherit success/danger styling
            if (src.id === 'terminalExit') {
                dst.textContent = src.textContent;
                dst.className = src.className;
            }
        };
        sync();
        new MutationObserver(sync).observe(src, { attributes: true, childList: true, subtree: true, characterData: true });
    };
    mirror('terminalStatus', 'stickyStatus');
    mirror('terminalDuration', 'stickyDuration');
    mirror('terminalExit', 'stickyExit');

    // Mirror Run button busy state (from #runBtn or #runBtnBottom — whichever exists)
    const runSrc = document.getElementById('runBtn') || document.getElementById('runBtnBottom');
    const runDst = document.getElementById('stickyRunBtn');
    if (runSrc && runDst) {
        new MutationObserver(() => {
            runDst.classList.toggle('running', runSrc.classList.contains('running'));
            // Sync the inner label/spinner
            const hasSpinner = runSrc.innerHTML.includes('btn-spinner');
            runDst.innerHTML = hasSpinner
                ? '<span class="btn-spinner me-1"></span>Running...'
                : `<i class="bi bi-play-fill me-1"></i>${isTemplate ? 'Run with Params' : 'Run'}`;
        }).observe(runSrc, { attributes: true, childList: true, subtree: true });
    }
    // Mirror Stop button visibility/state
    const stopSrc = document.getElementById('stopBtn'), stopDst = document.getElementById('stickyStopBtn');
    if (stopSrc && stopDst) {
        const syncStop = () => {
            stopDst.style.display = stopSrc.style.display;
            stopDst.disabled = stopSrc.disabled;
            stopDst.innerHTML = stopSrc.innerHTML;
        };
        syncStop();
        new MutationObserver(syncStop).observe(stopSrc, { attributes: true, childList: true, subtree: true });
    }
})();

if (detected) {
    buildForm(detected.items);

    // Conditional section visibility based on examMode
    (function setupConditionalSections() {
        const container = document.getElementById('paramFormFields');
        if (!container) return;
        let currentSection = null;
        for (const el of Array.from(container.children)) {
            const lbl = el.querySelector('.param-section-label');
            if (lbl) {
                const txt = lbl.textContent.toLowerCase();
                currentSection = txt.includes('saq mode only') ? 'saq'
                               : txt.includes('online written mode only') ? 'written'
                               : null;
                if (currentSection) el.dataset.condSection = currentSection;
                else el.removeAttribute('data-cond-section');
            } else if (currentSection) {
                el.dataset.condSection = currentSection;
            }
        }
        function refresh() {
            const modeEl = container.querySelector('[data-key="examMode"]');
            const mode = modeEl ? modeEl.value : '';
            const showSaq     = mode === 'saq_only'  || mode === 'mcq_saq';
            const showWritten = mode === 'mcq_written' || mode === 'written_only';
            container.querySelectorAll('[data-cond-section]').forEach(el => {
                const s = el.dataset.condSection;
                el.style.display = (s === 'saq' ? showSaq : showWritten) ? '' : 'none';
            });
        }
        const modeEl = container.querySelector('[data-key="examMode"]');
        if (modeEl) { modeEl.addEventListener('change', refresh); refresh(); }
    })();

    // Pre-fill defaults from item definitions (before saved values override them)
    const defaults = {};
    detected.items.filter(d => d.type === 'field' && d.defaultVal != null)
        .forEach(d => { defaults[d.key] = d.defaultVal; });
    // defaults already applied via value= in HTML; objToForm is for saved overrides

    // Load saved values (override defaults)
    const saved = localStorage.getItem(storageKey);
    if (saved) {
        try { objToForm(JSON.parse(saved)); } catch (_) {}
    }

    document.getElementById('formViewBtn').addEventListener('click', switchToForm);
    document.getElementById('jsonViewBtn').addEventListener('click', switchToJson);
}
</script>
}
