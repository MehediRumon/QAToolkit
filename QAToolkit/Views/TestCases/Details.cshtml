@model QAToolkit.Models.TestCaseDoc
@{
    ViewData["Title"] = Model.Title;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    if (!isAuthenticated)
    {
        Layout = null;
    }
}

@if (!isAuthenticated)
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@Model.Title - QA Toolkit</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    </head>
    <body style="margin: 0;">
        <div class="no-print" style="position: sticky; top: 0; z-index: 999; background: #fff; border-bottom: 1px solid #dee2e6; padding: 10px 20px;">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-clipboard2-check"></i> @Model.Title</h6>
                    @if (!string.IsNullOrEmpty(Model.Project))
                    {
                        <span class="badge bg-info">@Model.Project</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Module))
                    {
                        <span class="badge bg-secondary">@Model.Module</span>
                    }
                    <span class="text-muted small">
                        <i class="bi bi-person"></i> @(Model.CreatedBy ?? "N/A")
                        <span class="mx-1">|</span>
                        <i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </span>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="printDoc()">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
            </div>
        </div>
        <iframe id="docFrame" srcdoc="@Model.HtmlContent" style="width: 100%; border: none; height: 0;"></iframe>
        <script>
            document.getElementById('docFrame').addEventListener('load', function() {
                try { this.style.height = this.contentWindow.document.documentElement.scrollHeight + 'px'; } catch(e) { this.style.height = '100vh'; }
            });
            function printDoc() {
                var frame = document.getElementById('docFrame');
                try { frame.contentWindow.print(); } catch(e) { window.print(); }
            }
        </script>
    </body>
    </html>
}
else
{
    <div class="sticky-header no-print">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clipboard2-check"></i> @Model.Title</h5>
                @if (!string.IsNullOrEmpty(Model.Project))
                {
                    <span class="badge bg-info">@Model.Project</span>
                }
                @if (!string.IsNullOrEmpty(Model.Module))
                {
                    <span class="badge bg-secondary">@Model.Module</span>
                }
                @if (Model.IsPublic)
                {
                    <span class="badge bg-success">Public</span>
                }
                <span class="text-muted small">
                    <i class="bi bi-person"></i> @(Model.CreatedBy ?? "N/A")
                    <span class="mx-1">|</span>
                    <i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("MMM dd, yyyy")
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <span class="mx-1">|</span>
                        <span><i class="bi bi-pencil"></i> @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                    }
                </span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" onclick="printDoc()">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <iframe id="docFrame" srcdoc="@Model.HtmlContent" style="width: 100%; border: none; height: 0;"></iframe>
        </div>
    </div>
}

@if (isAuthenticated)
{
    @section Scripts {
    <script>
        document.getElementById('docFrame').addEventListener('load', function() {
            try { this.style.height = this.contentWindow.document.documentElement.scrollHeight + 20 + 'px'; } catch(e) { this.style.height = '800px'; }
        });
        function printDoc() {
            var frame = document.getElementById('docFrame');
            try { frame.contentWindow.print(); } catch(e) { window.print(); }
        }
    </script>
    }
}
