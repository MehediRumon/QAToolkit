@model QAToolkit.Models.Automation.TestReportViewModel
@{
    ViewData["Title"] = $"Test Report - {Model.Status.RunId}";
    Layout = "_Layout";
}

<style>
    .report-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }
    .status-badge {
        display: inline-block;
        padding: 8px 24px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 1.1rem;
    }
    .status-badge.passed { background: #28a745; }
    .status-badge.failed { background: #dc3545; }
    .status-badge.error { background: #6c757d; }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        height: 100%;
    }
    .stat-card .value {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1;
    }
    .stat-card .label {
        color: #666;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }
    .stat-card.passed .value { color: #28a745; }
    .stat-card.failed .value { color: #dc3545; }
    .stat-card.skipped .value { color: #ffc107; }
    .stat-card.rate .value { color: #007bff; }

    .pass-rate-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 1.8rem;
        font-weight: 700;
        background: conic-gradient(
            #28a745 0deg @(Model.PassRate * 3.6)deg,
            #e9ecef @(Model.PassRate * 3.6)deg 360deg
        );
        position: relative;
    }
    .pass-rate-circle::before {
        content: '';
        width: 90px;
        height: 90px;
        background: white;
        border-radius: 50%;
        position: absolute;
    }
    .pass-rate-circle span {
        position: relative;
        z-index: 1;
    }

    .test-card {
        background: white;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        border-left: 4px solid #ccc;
    }
    .test-card.passed { border-left-color: #28a745; }
    .test-card.failed { border-left-color: #dc3545; }
    .test-card.skipped { border-left-color: #ffc107; }

    .error-box {
        background: #fff5f5;
        border: 1px solid #ffcccc;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 0.75rem;
        font-family: 'Consolas', monospace;
        font-size: 0.85rem;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 300px;
        overflow-y: auto;
    }

    .stack-trace {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 0.5rem;
        font-family: 'Consolas', monospace;
        font-size: 0.8rem;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 200px;
        overflow-y: auto;
        color: #666;
    }

    .screenshot-container {
        margin-top: 1rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
    }
    .screenshot-container img {
        max-width: 100%;
        cursor: pointer;
    }

    .insight-card {
        background: white;
        border-radius: 10px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .insight-card h6 {
        color: #666;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
    }

    .log-timeline {
        font-family: 'Consolas', monospace;
        font-size: 0.85rem;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        max-height: 250px;
        overflow-y: auto;
    }
    .log-timeline .log-entry {
        padding: 0.25rem 0;
        border-bottom: 1px solid #eee;
    }
    .log-timeline .log-entry:last-child {
        border-bottom: none;
    }

    .nav-tabs .nav-link {
        color: #666;
        border: none;
        padding: 0.75rem 1.5rem;
    }
    .nav-tabs .nav-link.active {
        color: #007bff;
        border-bottom: 3px solid #007bff;
        background: transparent;
    }

    .category-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 15px;
        font-size: 0.8rem;
        margin: 0.25rem;
        background: #e9ecef;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="@Url.Action("Index", "Automation")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
    <button class="btn btn-outline-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Print Report
    </button>
</div>

<!-- Report Header -->
<div class="report-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="mb-1">Test Execution Report</h2>
            <div class="mb-2 opacity-75">
                <i class="bi bi-hash"></i> @Model.Status.RunId
            </div>
            <div class="small opacity-75">
                <span><i class="bi bi-calendar3"></i> @Model.Status.StartTime.ToString("MMMM dd, yyyy HH:mm:ss")</span>
                <span class="ms-3"><i class="bi bi-clock"></i> Duration: @Model.Status.Duration</span>
                @if (!string.IsNullOrEmpty(Model.Status.TriggeredBy))
                {
                    <span class="ms-3"><i class="bi bi-person"></i> @Model.Status.TriggeredBy</span>
                }
            </div>
        </div>
        <div class="col-md-4 text-end">
            <span class="status-badge @Model.Status.Status.ToLower()">@Model.Status.Status</span>
        </div>
    </div>
</div>

<!-- Stats Row -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="stat-card">
            <div class="value">@Model.Status.TotalTests</div>
            <div class="label">Total Tests</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card passed">
            <div class="value">@Model.Status.PassedTests</div>
            <div class="label">Passed</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card failed">
            <div class="value">@Model.Status.FailedTests</div>
            <div class="label">Failed</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card skipped">
            <div class="value">@Model.Status.SkippedTests</div>
            <div class="label">Skipped</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card rate">
            <div class="pass-rate-circle">
                <span>@Model.PassRate.ToString("0")%</span>
            </div>
            <div class="label mt-2">Pass Rate</div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column - Test Results -->
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#failed-tests">
                            <i class="bi bi-x-circle text-danger"></i> Failed (@Model.FailedTests.Count)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#passed-tests">
                            <i class="bi bi-check-circle text-success"></i> Passed (@Model.PassedTests.Count)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#all-tests">
                            <i class="bi bi-list-ul"></i> All Tests
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content" style="max-height: 600px; overflow-y: auto;">
                <!-- Failed Tests Tab -->
                <div class="tab-pane fade show active" id="failed-tests">
                    @if (Model.FailedTests.Count == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-emoji-smile" style="font-size: 3rem;"></i>
                            <p class="mt-2">No failed tests! Great job!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var test in Model.FailedTests)
                        {
                            <div class="test-card failed">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong class="text-danger"><i class="bi bi-x-circle-fill"></i> @test.Name.Split('.').Last()</strong>
                                        <div class="small text-muted">@test.Name</div>
                                    </div>
                                    <span class="badge bg-secondary">@test.Duration</span>
                                </div>

                                @if (!string.IsNullOrEmpty(test.ErrorMessage))
                                {
                                    <div class="error-box">
                                        <strong class="text-danger"><i class="bi bi-exclamation-triangle"></i> Error:</strong>
                                        <div class="mt-1">@test.ErrorMessage</div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(test.StackTrace))
                                {
                                    <details class="mt-2">
                                        <summary class="text-muted" style="cursor: pointer;">
                                            <i class="bi bi-code-slash"></i> View Stack Trace
                                        </summary>
                                        <div class="stack-trace">@test.StackTrace</div>
                                    </details>
                                }

                                @if (!string.IsNullOrEmpty(test.ScreenshotBase64))
                                {
                                    <div class="screenshot-container">
                                        <div class="p-2 bg-light border-bottom">
                                            <i class="bi bi-image"></i> Screenshot at failure
                                        </div>
                                        <img src="data:image/png;base64,@test.ScreenshotBase64"
                                             alt="Screenshot"
                                             onclick="openScreenshot(this.src)"
                                             title="Click to enlarge" />
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Passed Tests Tab -->
                <div class="tab-pane fade" id="passed-tests">
                    @if (Model.PassedTests.Count == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-2">No passed tests.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var test in Model.PassedTests)
                        {
                            <div class="test-card passed">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-success"><i class="bi bi-check-circle-fill"></i> @test.Name.Split('.').Last()</strong>
                                        <div class="small text-muted">@test.Name</div>
                                    </div>
                                    <span class="badge bg-secondary">@test.Duration</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- All Tests Tab -->
                <div class="tab-pane fade" id="all-tests">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Test Name</th>
                                <th>Status</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var test in Model.Status.TestCases.OrderBy(t => t.Status == "Failed" ? 0 : 1).ThenBy(t => t.Name))
                            {
                                <tr>
                                    <td>
                                        <span title="@test.Name">@test.Name.Split('.').Last()</span>
                                    </td>
                                    <td>
                                        @if (test.Status.Equals("Passed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">Passed</span>
                                        }
                                        else if (test.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">@test.Status</span>
                                        }
                                    </td>
                                    <td class="text-muted">@test.Duration</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column - Insights -->
    <div class="col-lg-4">
        <!-- Run Configuration -->
        <div class="insight-card mb-3">
            <h6><i class="bi bi-gear"></i> Run Configuration</h6>
            <table class="table table-sm table-borderless mb-0">
                <tr><td class="text-muted">Suite</td><td class="text-end fw-medium">@Model.Status.Suite</td></tr>
                <tr><td class="text-muted">Project</td><td class="text-end fw-medium">@Model.Status.Project</td></tr>
                <tr><td class="text-muted">Browser</td><td class="text-end fw-medium">@Model.Status.Browser</td></tr>
                <tr><td class="text-muted">Environment</td><td class="text-end fw-medium">@Model.Status.Environment</td></tr>
            </table>
        </div>

        <!-- Slowest Tests -->
        @if (Model.SlowestTests.Any())
        {
            <div class="insight-card mb-3">
                <h6><i class="bi bi-speedometer2"></i> Slowest Tests</h6>
                @foreach (var test in Model.SlowestTests.Take(5))
                {
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                        <span class="text-truncate" style="max-width: 180px;" title="@test.Name">
                            @test.Name.Split('.').Last()
                        </span>
                        <span class="badge bg-warning text-dark">@test.Duration</span>
                    </div>
                }
            </div>
        }

        <!-- Failure Categories -->
        @if (Model.FailureCategories.Any())
        {
            <div class="insight-card mb-3">
                <h6><i class="bi bi-pie-chart"></i> Failure Categories</h6>
                @foreach (var category in Model.FailureCategories.OrderByDescending(c => c.Value))
                {
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <span class="category-badge">@category.Key</span>
                        <span class="badge bg-danger">@category.Value</span>
                    </div>
                }
            </div>
        }

        <!-- Execution Logs -->
        @if (Model.ExecutionLogs.Any())
        {
            <div class="insight-card mb-3">
                <h6><i class="bi bi-journal-text"></i> Execution Log</h6>
                <div class="log-timeline">
                    @foreach (var log in Model.ExecutionLogs)
                    {
                        <div class="log-entry">@log</div>
                    }
                </div>
            </div>
        }

        <!-- Quick Actions -->
        <div class="insight-card">
            <h6><i class="bi bi-lightning"></i> Quick Actions</h6>
            <div class="d-grid gap-2">
                @if (Model.Status.Status == "FAILED")
                {
                    <form asp-action="Retry" asp-route-runId="@Model.Status.RunId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning w-100">
                            <i class="bi bi-arrow-repeat"></i> Retry Failed Tests
                        </button>
                    </form>
                }
                <a href="@Url.Action("Index", "Automation")" class="btn btn-outline-primary">
                    <i class="bi bi-plus-circle"></i> Run New Tests
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Screenshot Modal -->
<div class="modal fade" id="screenshotModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Screenshot</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalScreenshot" src="" alt="Screenshot" style="max-width: 100%;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openScreenshot(src) {
        document.getElementById('modalScreenshot').src = src;
        new bootstrap.Modal(document.getElementById('screenshotModal')).show();
    }
</script>
}
