@model IEnumerable<QAToolkit.Models.Workflow>
@{
    ViewData["Title"] = "Workflows";
}

<div class="page-header">
    <div>
        <h1>Workflows</h1>
        <p>Document and share team workflows with HTML imports and public links.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Workflow</a>
    </div>
</div>

@if ((ViewBag.Categories as List<string?>)?.Any() == true)
{
    <form method="get" class="toolbar">
        <span class="toolbar-label">Category</span>
        <select name="category" class="form-select">
            <option value="">All</option>
            @foreach (var cat in ViewBag.Categories as List<string?>)
            {
                <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        <a href="/Workflows" class="btn btn-sm btn-ghost">Clear</a>
    </form>
}

<!-- Workflows Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle" style="width: 3%">#</th>
                        <th class="align-middle" style="width: 30%">Name</th>
                        <th class="text-center align-middle" style="width: 15%">Category</th>
                        <th class="text-center align-middle" style="width: 8%">Public</th>
                        <th class="text-center align-middle" style="width: 12%">Created By</th>
                        <th class="text-center align-middle" style="width: 12%">Date</th>
                        <th class="text-center align-middle" style="width: 10%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var index = 1;
                        @foreach (var workflow in Model)
                        {
                            <tr>
                                <td class="text-center align-middle">@index</td>
                                <td class="align-middle">
                                    <a asp-action="Details" asp-route-id="@workflow.Id" class="text-decoration-none fw-medium">
                                        @workflow.Name
                                    </a>
                                </td>
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrEmpty(workflow.Category))
                                    {
                                        <span class="badge bg-secondary">@workflow.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (workflow.IsPublic)
                                    {
                                        <span class="badge-status success">Public</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status muted">Private</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <small>@(workflow.CreatedBy ?? "N/A")</small>
                                </td>
                                <td class="text-center align-middle">
                                    <small>@workflow.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td class="text-center align-middle text-nowrap">
                                    <a asp-action="Details" asp-route-id="@workflow.Id" class="btn btn-sm btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (workflow.CreatedBy == User.Identity?.Name)
                                    {
                                        <a asp-action="Edit" asp-route-id="@workflow.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@workflow.Id" method="post" class="d-inline"
                                              data-confirm="Delete this workflow? This action cannot be undone." data-confirm-title="Delete workflow">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-state-icon"><i class="bi bi-diagram-3"></i></div>
                                    <h5>No workflows yet</h5>
                                    <p>Upload an HTML file to document your first workflow.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Workflow</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
