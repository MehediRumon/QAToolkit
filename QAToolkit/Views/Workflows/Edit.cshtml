@model QAToolkit.Models.Workflow
@{
    ViewData["Title"] = "Edit Workflow";
}

<div class="page-header">
    <div><h1>Edit Workflow</h1></div>
    <div class="page-header-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-medium">Workflow Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" value="@Model.Name" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-medium">Category</label>
                            <input type="text" name="category" class="form-control" value="@Model.Category" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" name="isPublic" value="true" class="form-check-input" id="isPublicCheck"
                                   @(Model.IsPublic ? "checked" : "") />
                            <label class="form-check-label fw-medium" for="isPublicCheck">
                                Public <small class="text-muted fw-normal">— anyone with the link can view without logging in</small>
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Replace HTML File</label>
                        <input type="file" name="htmlFile" class="form-control" accept=".html,.htm" id="htmlFileInput" />
                        <small class="text-muted">Leave empty to keep the current HTML. Upload a new file to replace it.</small>
                    </div>

                    <!-- Current preview -->
                    <div class="mb-4">
                        <label class="form-label fw-medium">Current Preview</label>
                        <div class="border rounded" style="max-height: 500px; overflow: auto;">
                            <iframe id="previewFrame" srcdoc="@Model.HtmlContent" style="width: 100%; height: 500px; border: none;"></iframe>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Update Workflow
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('htmlFileInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(ev) {
                document.getElementById('previewFrame').srcdoc = ev.target.result;
            };
            reader.readAsText(file);
        }
    });
</script>
}
