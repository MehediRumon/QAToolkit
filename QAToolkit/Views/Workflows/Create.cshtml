@{
    ViewData["Title"] = "Add Workflow";
}

<div class="page-header">
    <div>
        <h1>Add Workflow</h1>
        <p>Upload an HTML file to document a new workflow.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="uploadForm">
                    <div class="row mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-medium">Workflow Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="e.g., Splitting Exam Workflow" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-medium">Category</label>
                            <input type="text" name="category" class="form-control" placeholder="e.g., UMS, ERP, Portal" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" name="isPublic" value="true" class="form-check-input" id="isPublicCheck" />
                            <label class="form-check-label fw-medium" for="isPublicCheck">
                                Public <small class="text-muted fw-normal">— anyone with the link can view without logging in</small>
                            </label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-medium">HTML File <span class="text-danger">*</span></label>
                        <input type="file" name="htmlFile" class="form-control" accept=".html,.htm" required id="htmlFileInput" />
                        <small class="text-muted">Upload an .html file — it will be rendered exactly as-is</small>
                    </div>

                    <!-- Preview -->
                    <div id="previewSection" class="mb-4 d-none">
                        <label class="form-label fw-medium">Preview</label>
                        <div class="border rounded" style="max-height: 500px; overflow: auto;">
                            <iframe id="previewFrame" style="width: 100%; height: 500px; border: none;"></iframe>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload me-1"></i> Upload Workflow
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('htmlFileInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(ev) {
                const frame = document.getElementById('previewFrame');
                frame.srcdoc = ev.target.result;
                document.getElementById('previewSection').classList.remove('d-none');
            };
            reader.readAsText(file);
        }
    });
</script>
}
