@model IEnumerable<QAToolkit.Models.User>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h1>User Management</h1>
        <p>Manage team members and their access permissions.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add User
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle">Name</th>
                        <th class="text-center align-middle">Email</th>
                        <th class="text-center align-middle">Status</th>
                        <th class="text-center align-middle">Last Login</th>
                        <th class="text-center align-middle">Created</th>
                        <th class="text-center align-middle">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle"><strong>@user.Name</strong></td>
                            <td class="align-middle"><small>@user.Email</small></td>
                            <td class="text-center align-middle">
                                @if (user.IsActive)
                                {
                                    <span class="badge-status success">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status muted">Inactive</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <small>@(user.LastLogin?.ToString("MMM dd, yyyy hh:mm tt") ?? "Never")</small>
                            </td>
                            <td class="text-center align-middle">
                                <small>@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="text-center align-middle text-nowrap">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#resetPasswordModal-@user.Id" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </button>
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                      data-confirm="Delete this user? This action cannot be undone." data-confirm-title="Delete user">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                    <!-- Reset Password Modal -->
                    <div class="modal fade" id="resetPasswordModal-@user.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Reset Password for @user.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">New Password</label>
                                            <input type="password" name="newPassword" class="form-control" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Reset Password</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-people"></i></div>
                <h5>No users yet</h5>
                <p>Add your first team member.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add User</a>
            </div>
        }
    </div>
</div>
