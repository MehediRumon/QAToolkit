@model IEnumerable<QAToolkit.Models.UrlResource>
@{
    ViewData["Title"] = "URL Manager";
}

<div class="page-header">
    <div>
        <h1>URL Manager</h1>
        <p>Saved URLs for staging, production, APIs, and more.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add URL
        </a>
    </div>
</div>

<form method="get" class="toolbar">
    <span class="toolbar-label">Category</span>
    <select name="category" class="form-select">
        <option value="">All</option>
        @foreach (var cat in ViewBag.Categories as List<string?>)
        {
            <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
        }
    </select>
    <span class="toolbar-label">Project</span>
    <select name="project" class="form-select">
        <option value="">All</option>
        @foreach (var proj in ViewBag.Projects as List<string?>)
        {
            <option value="@proj" selected="@(ViewBag.SelectedProject == proj)">@proj</option>
        }
    </select>
    <button type="submit" class="btn btn-sm btn-secondary">
        <i class="bi bi-funnel"></i> Filter
    </button>
    <a href="/UrlResources" class="btn btn-sm btn-ghost">Clear</a>
</form>

<!-- URL List -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle" style="width: 40px;"></th>
                        <th class="text-center align-middle" style="width: 18%">Name</th>
                        <th class="text-center align-middle" style="width: 35%">URL</th>
                        <th class="text-center align-middle" style="width: 12%">Category</th>
                        <th class="text-center align-middle" style="width: 12%">Environment</th>
                        <th class="text-center align-middle" style="width: 13%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center align-middle">
                                <form asp-action="ToggleFavorite" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-ghost p-1">
                                        @if (item.IsFavorite)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="align-middle">
                                <div class="fw-medium">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.Project))
                                {
                                    <small class="text-muted">@item.Project</small>
                                }
                            </td>
                            <td class="align-middle">
                                <div class="d-flex align-items-center gap-1">
                                    <a href="@item.Url" target="_blank" class="text-truncate small" style="max-width: 360px;">
                                        @item.Url
                                    </a>
                                    <button class="btn btn-sm btn-ghost p-1" onclick="copyToClipboard('@item.Url', this)" title="Copy URL">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(item.Category))
                                {
                                    <span class="badge bg-secondary">@item.Category</span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(item.Environment))
                                {
                                    var envClass = item.Environment?.ToLower() switch
                                    {
                                        "dev" => "badge-env-dev",
                                        "live" => "badge-env-prod",
                                        "alpha" => "badge-env-qa",
                                        "rc" => "badge-env-staging",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @envClass">@item.Environment</span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center align-middle text-nowrap">
                                <a href="@item.Url" target="_blank" class="btn btn-sm btn-outline-primary" title="Open">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      data-confirm="Delete this URL? This action cannot be undone." data-confirm-title="Delete URL">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-link-45deg"></i></div>
            <h5>No URLs yet</h5>
            <p>Save your first URL for easy access.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add URL</a>
        </div>
    }
</div>
