@model QAToolkit.Models.UrlResource
@{
    ViewData["Title"] = "Add URL";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-lg"></i> Add URL</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Staging Login Page" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Url" class="form-label">URL <span class="text-danger">*</span></label>
                        <input asp-for="Url" class="form-control" placeholder="https://example.com" />
                        <span asp-validation-for="Url" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select Category</option>
                                <option>UMS</option>
                                <option>Student Portal</option>
                                <option>Teacher Portal</option>
                                <option>Scheduler</option>
                                <option>OM</option>
                                <option>API</option>
                                <option>App</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Environment" class="form-label">Environment</label>
                            <select asp-for="Environment" class="form-select">
                                <option value="">Select Environment</option>
                                <option>Dev</option>
                                <option>Live</option>
                                <option>Alpha</option>
                                <option>RC</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Project" class="form-label">Project</label>
                        <input asp-for="Project" class="form-control" placeholder="e.g., E-Commerce Website" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional description"></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsFavorite" class="form-check-input" />
                        <label asp-for="IsFavorite" class="form-check-label">Mark as Favorite</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save URL
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
