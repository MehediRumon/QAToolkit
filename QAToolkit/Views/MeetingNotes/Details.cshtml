@model QAToolkit.Models.MeetingNote
@{
    ViewData["Title"] = "Meeting Details";
    var statusClass = Model.Status switch
    {
        "Need to Implement" => "warning",
        "Implement Later" => "info",
        "Invalid" => "muted",
        "Closed" => "success",
        "Cancelled" => "danger",
        _ => "muted"
    };
}

<div class="page-header no-print">
    <div>
        <h1>@Model.Topics</h1>
        <div class="d-flex align-items-center gap-2 mt-2">
            @if (!string.IsNullOrEmpty(Model.MeetingWith))
            {
                <span class="badge bg-primary">@Model.MeetingWith</span>
            }
            @if (!string.IsNullOrEmpty(Model.Status))
            {
                <span class="badge-status @statusClass">@Model.Status</span>
            }
            <span class="text-muted small">
                <i class="bi bi-calendar3"></i> @Model.MeetingDate.ToString("MMMM dd, yyyy")
            </span>
        </div>
    </div>
    <div class="page-header-actions">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="detail-meta no-print">
    <div class="detail-meta-item">
        <span class="detail-meta-label">Date</span>
        <span class="detail-meta-value">@Model.MeetingDate.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="detail-meta-item">
        <span class="detail-meta-label">Meeting With</span>
        <span class="detail-meta-value">@(Model.MeetingWith ?? "—")</span>
    </div>
    <div class="detail-meta-item">
        <span class="detail-meta-label">Attendees</span>
        <span class="detail-meta-value">@(Model.Attendees ?? "—")</span>
    </div>
    <div class="detail-meta-item">
        <span class="detail-meta-label">Decision By</span>
        <span class="detail-meta-value">@(Model.DecisionBy ?? "—")</span>
    </div>
</div>

<div class="detail-section">
    <div class="detail-section-title"><i class="bi bi-journal-text"></i> Decisions</div>
    <div class="detail-content">@Model.Decisions</div>
</div>

<div class="detail-footer no-print">
    <div class="detail-footer-item">
        <span class="label">Created By</span>
        <span class="value">@(Model.CreatedBy ?? "N/A") &middot; @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.ModifiedBy) || Model.UpdatedAt.HasValue)
    {
        <div class="detail-footer-item">
            <span class="label">Modified By</span>
            <span class="value">@(Model.ModifiedBy ?? "—") &middot; @(Model.UpdatedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</span>
        </div>
    }
</div>
